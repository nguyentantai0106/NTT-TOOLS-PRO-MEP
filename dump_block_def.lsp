(setq blk (tblobjname "BLOCK" "A$C823e7d62"))
(if blk
  (progn
    (setq ent (entnext blk))
    (while ent
      (setq elist (entget ent))
      (setq etype (cdr (assoc 0 elist)))
      (princ (strcat "\nBLOCK ENTITY: " etype))
      (if (or (= etype "TEXT") (= etype "MTEXT"))
        (princ (strcat " text=[" (cdr (assoc 1 elist)) "] pt=" (vl-prin1-to-string (cdr (assoc 10 elist)))))
      )
      (if (= etype "LINE")
        (princ (strcat " from=" (vl-prin1-to-string (cdr (assoc 10 elist))) " to=" (vl-prin1-to-string (cdr (assoc 11 elist)))))
      )
      (if (= etype "CIRCLE")
        (princ (strcat " center=" (vl-prin1-to-string (cdr (assoc 10 elist))) " rad=" (rtos (cdr (assoc 40 elist)) 2 2)))
      )
      (if (= etype "LWPOLYLINE")
        (princ (strcat " poly"))
      )
      (setq ent (entnext ent))
    )
  )
  (princ "\nBlock not found!")
)
(princ "\n---ALL DONE---")
(command "QUIT" "_Y")
