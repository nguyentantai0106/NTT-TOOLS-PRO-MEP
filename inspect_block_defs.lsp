(setq blk (tblnext "BLOCK" T))
(while blk
  (setq bname (cdr (assoc 2 blk)))
  (princ (strcat "\nBLOCK DEF: " bname))
  (setq ent (cdr (assoc -2 blk)))
  (while ent
    (setq elist (entget ent))
    (setq etype (cdr (assoc 0 elist)))
    (if (= etype "CIRCLE")
      (princ (strcat " [CIRCLE center=" (vl-prin1-to-string (cdr (assoc 10 elist))) " rad=" (rtos (cdr (assoc 40 elist)) 2 2) "]"))
    )
    (if (= etype "TEXT")
      (princ (strcat " [TEXT " (cdr (assoc 1 elist)) " h=" (rtos (cdr (assoc 40 elist)) 2 2) "]"))
    )
    (setq ent (entnext ent))
  )
  (setq blk (tblnext "BLOCK"))
)
(princ "\n---ALL BLOCKS DONE---")
(command "QUIT" "_Y")
