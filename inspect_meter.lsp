(setq ent (entnext))
(while ent
  (setq elist (entget ent))
  (setq etype (cdr (assoc 0 elist)))
  (setq layer (cdr (assoc 8 elist)))
  (cond
    ((= etype "LINE")
     (setq sp (cdr (assoc 10 elist)))
     (setq ep (cdr (assoc 11 elist)))
     (if (and (<= (car sp) 5650.0) (>= (car sp) 5550.0) (<= (cadr sp) 50.0) (>= (cadr sp) -50.0))
       (princ (strcat "\nLINE: (" (rtos (car sp) 2 2) "," (rtos (cadr sp) 2 2) ") -> (" (rtos (car ep) 2 2) "," (rtos (cadr ep) 2 2) ") Layer: " layer))
     )
    )
    ((= etype "CIRCLE")
     (setq pt (cdr (assoc 10 elist)))
     (setq rad (cdr (assoc 40 elist)))
     (if (and (<= (car pt) 5650.0) (>= (car pt) 5550.0) (<= (cadr pt) 50.0) (>= (cadr pt) -50.0))
       (princ (strcat "\nCIRCLE: center=(" (rtos (car pt) 2 2) "," (rtos (cadr pt) 2 2) ") rad=" (rtos rad 2 2) " Layer: " layer))
     )
    )
    ((or (= etype "TEXT") (= etype "MTEXT"))
     (setq pt (cdr (assoc 10 elist)))
     (setq txt (cdr (assoc 1 elist)))
     (if (and (<= (car pt) 5650.0) (>= (car pt) 5550.0) (<= (cadr pt) 50.0) (>= (cadr pt) -50.0))
       (princ (strcat "\nTEXT: [" txt "] at (" (rtos (car pt) 2 2) "," (rtos (cadr pt) 2 2) ") Layer: " layer))
     )
    )
    ((= etype "INSERT")
     (setq pt (cdr (assoc 10 elist)))
     (setq bn (cdr (assoc 2 elist)))
     (setq sx (cdr (assoc 41 elist)))
     (if (and (<= (car pt) 5650.0) (>= (car pt) 5550.0) (<= (cadr pt) 50.0) (>= (cadr pt) -50.0))
       (princ (strcat "\nINSERT: [" bn "] at (" (rtos (car pt) 2 2) "," (rtos (cadr pt) 2 2) ") sx=" (rtos sx 2 4) " Layer: " layer))
     )
    )
  )
  (setq ent (entnext ent))
)
(princ "\n---ALL DONE---")
(command "QUIT" "_Y")
