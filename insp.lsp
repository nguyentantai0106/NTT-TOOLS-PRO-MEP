(defun c:insp ()
  (setq e (entnext))
  (while e
    (setq d (entget e))
    (princ (strcat (cdr (assoc 0 d)) " "))
    (setq pts nil)
    (foreach item d (if (= (car item) 10) (setq pts (cons (cdr item) pts))))
    (if pts (princ (vl-prin1-to-string pts)))
    (princ "\n")
    (setq e (entnext e))
  )
  (command "_QUIT" "_Y")
)
(c:insp)
