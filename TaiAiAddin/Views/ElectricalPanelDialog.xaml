                                              Foreground="#F8FAFC" BorderBrush="#333D54" BorderThickness="1" RowHeight="30"
                                              MaxHeight="270" HorizontalGridLinesBrush="#2A3246" VerticalGridLinesBrush="#2A3246" VerticalScrollBarVisibility="Auto">
                                        <DataGrid.ColumnHeaderStyle>
