                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="#2A3246"/>
                                                        <Setter Property="Foreground" Value="#00E5FF"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.CellStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Mạch" Binding="{Binding CircuitNumber}" Width="55" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Tên Phụ Tải Động Lực" Binding="{Binding LoadName}" Width="210"/>
                                            <DataGridTextColumn Header="Công Suất (kW)" Binding="{Binding PowerKW, StringFormat={}{0:0.##}}" Width="105"/>
                                            <DataGridTextColumn Header="Dòng Itt (A)" Binding="{Binding CurrentA, StringFormat={}{0:0.##}}" Width="95" IsReadOnly="True"/>
                                            <DataGridTemplateColumn Header="Phương Pháp Khởi Động V2" Width="210">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox Style="{StaticResource SldDarkComboBoxStyle}"
                                                                  SelectedValue="{Binding StarterDisplay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  SelectedValuePath="Tag"
                                                                  Height="24" Margin="0">
                                                            <ComboBoxItem Content="DOL (Khởi động trực tiếp)" Tag="DOL"/>
                                                            <ComboBoxItem Content="Y - Δ (Sao - Tam giác)" Tag="Y - Δ"/>
                                                            <ComboBoxItem Content="VFD (Biến tần)" Tag="VFD"/>
                                                            <ComboBoxItem Content="Soft Starter (Khởi động mềm)" Tag="Soft Starter"/>
                                                            <ComboBoxItem Content="- (Thường / Không KĐ)" Tag="-"/>
                                                        </ComboBox>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Aptomat Nhánh (CB)" Binding="{Binding BreakerSpec}" Width="145"/>
                                            <DataGridTextColumn Header="Cáp Động Lực &amp; Tiếp Địa" Binding="{Binding FullCableString}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- TAB 4: THÔNG TIN KHUNG TÊN BẢN VẼ A3 (TITLE BLOCK) -->

            <TabItem Header="📑 Khung Tên A3 &amp; Thông Tin Dự Án">

                <Grid Margin="12">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#E8F4FD" BorderBrush="#B6E0FE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">

                        <StackPanel>

                            <TextBlock Text="📐 CẤU HÌNH KHUNG BẢN VẼ A3 (TIÊU CHUẨN HE DIEN)" FontWeight="Bold" FontSize="13" Foreground="#005A9E" Margin="0,0,0,4"/>

                            <TextBlock Text="Khung tên được tự động lấy từ file 'HT - Khung ten A3-HE DIEN.dwg' chuẩn A3 nằm ngang (420 x 297 mm). Tất cả các trường thông tin bên dưới có thể được chỉnh sửa trực tiếp tại đây trước khi xuất hoặc chỉnh sửa bên trong vùng làm việc của AutoCAD." 

                                       TextWrapping="Wrap" FontSize="11.5" Foreground="#333"/>

                        </StackPanel>

                    </Border>

                    <Border Grid.Row="1" Background="White" BorderBrush="#E1E4E8" BorderThickness="1" CornerRadius="6" Padding="16">

                        <ScrollViewer VerticalScrollBarVisibility="Auto">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="150"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="36"/>

                                    <RowDefinition Height="36"/>

                                    <RowDefinition Height="36"/>

                                    <RowDefinition Height="36"/>

                                    <RowDefinition Height="36"/>

                                    <RowDefinition Height="36"/>

                                    <RowDefinition Height="36"/>

                                    <RowDefinition Height="36"/>

                                    <RowDefinition Height="36"/>

                                    <RowDefinition Height="Auto"/>

                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Tên Dự Án / Project:" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtProjectName" Text="CÔNG TRÌNH CƠ ĐIỆN TÒA NHÀ &amp; NHÀ XƯỞNG" Height="26" VerticalContentAlignment="Center" TextChanged="TitleBlock_TextChanged"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Tên Bản Vẽ / Title:" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtDrawingTitle" Text="SƠ ĐỒ NGUYÊN LÝ TỦ ĐIỆN" Height="26" VerticalContentAlignment="Center" TextChanged="TitleBlock_TextChanged"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Ký Hiệu Bản Vẽ / No:" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtDrawingNo" Text="EL-01" Width="160" HorizontalAlignment="Left" Height="26" VerticalContentAlignment="Center" TextChanged="TitleBlock_TextChanged"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Tỷ Lệ / Scale:" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtDrawingScale" Text="1:25" Width="160" HorizontalAlignment="Left" Height="26" VerticalContentAlignment="Center" TextChanged="TitleBlock_TextChanged"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Lần Sửa Đổi / Rev:" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtRevision" Text="00" Width="160" HorizontalAlignment="Left" Height="26" VerticalContentAlignment="Center" TextChanged="TitleBlock_TextChanged"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Kỹ Sư Thiết Kế:" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                <TextBox Grid.Row="5" Grid.Column="1" x:Name="txtDesignerName" Text="NTT TOOLS" Width="260" HorizontalAlignment="Left" Height="26" VerticalContentAlignment="Center" TextChanged="TitleBlock_TextChanged"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Người Vẽ / Drawn:" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                <TextBox Grid.Row="6" Grid.Column="1" x:Name="txtDrawnBy" Text="NGUYỄN TẤN TÀI" Width="260" HorizontalAlignment="Left" Height="26" VerticalContentAlignment="Center" TextChanged="TitleBlock_TextChanged"/>

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Kiểm Tra / Checked:" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                <TextBox Grid.Row="7" Grid.Column="1" x:Name="txtCheckedBy" Text="CAO VĂN SIÊU" Width="260" HorizontalAlignment="Left" Height="26" VerticalContentAlignment="Center" TextChanged="TitleBlock_TextChanged"/>

                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Phê Duyệt / Approved:" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                <TextBox Grid.Row="8" Grid.Column="1" x:Name="txtApprovedBy" Text="DƯƠNG CAO SƠN" Width="260" HorizontalAlignment="Left" Height="26" VerticalContentAlignment="Center" TextChanged="TitleBlock_TextChanged"/>

                                <StackPanel Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,16,0,0">

                                    <TextBlock Text="Đường dẫn file DWG Khung Tên A3:" FontWeight="SemiBold" Margin="0,0,0,4"/>

                                    <Grid>

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="Auto"/>

                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0" x:Name="txtTitleBlockPath" Text="C:\Users\ADMIN\Desktop\HT - Khung ten A3-HE DIEN.dwg" IsReadOnly="True" Height="26" VerticalContentAlignment="Center" Background="#F8F9FA"/>

                                        <Button Grid.Column="1" Content="📂 Chọn File Khác..." Style="{StaticResource OutlineBtn}" Margin="8,0,0,0" Padding="10,2" Click="BtnBrowseTitleBlock_Click"/>

                                    </Grid>

                                    <TextBlock x:Name="lblTitleBlockStatus" Text="✓ Đã tìm thấy file mẫu khung tên A3 hợp lệ." Foreground="#28A745" FontSize="11" Margin="0,4,0,0"/>

                                </StackPanel>

                            </Grid>

                        </ScrollViewer>

                    </Border>

                </Grid>

            </TabItem>

        </TabControl>

        <!-- 3. FOOTER: CÁC NÚT THAO TÁC XUẤT & CẬP NHẬT AUTOCAD -->

        <Border Grid.Row="2" Padding="0,10,0,0">

            <Grid>

                <TextBlock x:Name="txtDialogStatus" Text="Sẵn sàng. Bấm 'Vẽ Sơ Đồ Nguyên Lý Vào AutoCAD' hoặc 'Cập Nhật Tủ Điện Đã Vẽ'." 

                           VerticalAlignment="Center" Foreground="#666" FontSize="11"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                    <Button x:Name="btnUpdateInCad" Content="🔄 Cập Nhật Tủ Điện Đã Vẽ" 

                            Style="{StaticResource OutlineBtn}" Click="BtnUpdateInCad_Click" Margin="0,0,10,0" FontWeight="Bold" Foreground="#005A9E"/>

                    <Button x:Name="btnDrawEnclosureLayout" Content="📐 Vẽ Mặt Bằng Bố Trí Vỏ Tủ" 

                            Style="{StaticResource PurpleBtn}" Click="BtnDrawEnclosureLayout_Click" Margin="0,0,10,0"

                            ToolTip="Tự động tính toán kích thước, chọn block và xuất Mặt bằng bố trí vỏ tủ (Mặt ngoài, Cánh trong, Thiết bị bên trong, Mặt bên, Mặt đáy) ra AutoCAD"/>

                    <Button x:Name="btnDrawToCad" Content="🚀 Vẽ Sơ Đồ Nguyên Lý Vào AutoCAD" 

                            Style="{StaticResource SuccessBtn}" Click="BtnDrawToCad_Click" Margin="0,0,10,0"/>

                    <Button Content="Đóng" Style="{StaticResource OutlineBtn}" Click="BtnClose_Click"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

    <!-- ========================================================= -->
    <!-- LIGHTBOX MODAL OVERLAY (CHẾ ĐỘ XEM TOÀN MÀN HÌNH NÂNG CAO) -->
    <!-- ========================================================= -->
    <Grid x:Name="lightboxOverlay" Visibility="Collapsed" Focusable="True" MouseMove="Lightbox_MouseMove">
        <!-- 1. Backdrop làm tối toàn màn hình (Click ra ngoài để thoát) -->
        <Border Background="#E60B0F19" MouseLeftButtonDown="LightboxBackdrop_MouseLeftButtonDown"/>

        <!-- 2. Nội dung chính Lightbox -->
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top Floating Toolbar & Page Navigation -->
                <RowDefinition Height="*"/>    <!-- Canvas View Area -->
                <RowDefinition Height="Auto"/> <!-- Bottom Status / Shortcuts Guide -->
            </Grid.RowDefinitions>

            <!-- TOP BAR: BỘ ĐẾM TRANG/TỦ + FLOATING TOOLBAR + NÚT X ĐÓNG LỚN -->
            <Border Grid.Row="0" x:Name="pnlLightboxToolbar" Background="#1E2433" BorderBrush="#333D54" BorderThickness="1" 
                    CornerRadius="8" Padding="12,8" Margin="0,0,0,10" Effect="{StaticResource FloatingShadow}">
                <DockPanel LastChildFill="True">
                    <!-- Nút X Thoát Lớn Góc Phải -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="btnExitLightbox" Style="{StaticResource LightboxCloseBtn}" Click="BtnExitLightbox_Click" Margin="10,0,0,0" ToolTip="Đóng Lightbox (Phím ESC hoặc Click vùng ngoài)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✕" FontSize="15" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="ĐÓNG (ESC)" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Bộ Đếm Trang / Chuyển Tủ Điện (Trái) -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Border Background="#00E5FF" CornerRadius="4" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="⚡ SLD PREVIEW" FontWeight="Bold" FontSize="10" Foreground="#12161F"/>
                        </Border>
                        
                        <Button x:Name="btnLightboxPrev" Content="◀" Style="{StaticResource LightboxToolbarBtn}" Width="28" Height="28" Click="BtnLightboxPrev_Click" ToolTip="Tủ trước đó (Phím ← hoặc PageUp)"/>
                        <TextBlock x:Name="txtLightboxPanelCounter" Text="Tủ 1/3: TỦ TỔNG MSB" 
                                   FontWeight="SemiBold" FontSize="12" Foreground="#F8FAFC" 
                                   VerticalAlignment="Center" Margin="8,0" MinWidth="180" TextAlignment="Center"/>
                        <Button x:Name="btnLightboxNext" Content="▶" Style="{StaticResource LightboxToolbarBtn}" Width="28" Height="28" Click="BtnLightboxNext_Click" ToolTip="Tủ tiếp theo (Phím → hoặc PageDown)"/>
                        
                        <Separator Width="1" Height="18" Background="#333D54" Margin="10,0"/>

                        <!-- KIỂU & DẠNG SLD TRÊN LIGHTBOX (Dark Mode High-Contrast) -->
                        <TextBlock Text="Kiểu:" FontSize="11.5" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox x:Name="cboLightboxLayoutScheme" Style="{StaticResource SldDarkComboBoxStyle}" Width="165" Height="26" SelectionChanged="CboLightboxLayoutScheme_SelectionChanged" 
                                  Margin="0,0,10,0" ToolTip="Chọn Kiểu Bố Cục Sơ Đồ Nguyên Lý">
                            <ComboBoxItem Content="📐 Layout Basic (Bảng Tải)" IsSelected="True"/>
                            <ComboBoxItem Content="⚡ Kiểu Miền Nam (IEC)"/>
                            <ComboBoxItem Content="⭐ Kiểu Miền Bắc (TCVN)"/>
                            <ComboBoxItem Content="⚡ Kiểu SDNL V2 (MCC)"/>
                        </ComboBox>

                        <TextBlock Text="Dạng:" FontSize="11.5" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox x:Name="cboLightboxTreeOrientation" Style="{StaticResource SldDarkComboBoxStyle}" Width="115" Height="26" SelectionChanged="CboLightboxTreeOrientation_SelectionChanged" 
                                  ToolTip="Chọn Hướng / Dạng Cây Phân Cấp">
                            <ComboBoxItem Content="⬇️ Cây Đứng" IsSelected="True"/>
                            <ComboBoxItem Content="➡️ Cây Ngang"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Các Công Cụ Kiểm Soát Tỷ Lệ & Pan (Giữa) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Content="−" Style="{StaticResource LightboxToolbarBtn}" Width="30" Height="28" Click="BtnZoomOut_Click" ToolTip="Thu nhỏ (−)"/>
                        <TextBlock x:Name="txtLightboxZoom" Text="100%" FontSize="11.5" FontWeight="Bold" Foreground="#00E5FF" 
                                   VerticalAlignment="Center" Margin="6,0" MinWidth="48" TextAlignment="Center"/>
                        <Button Content="+" Style="{StaticResource LightboxToolbarBtn}" Width="30" Height="28" Click="BtnZoomIn_Click" ToolTip="Phóng to (+)"/>
                        
                        <Separator Width="1" Height="18" Background="#333D54" Margin="10,0"/>

                        <Button Content="⛶ Vừa Khung (F)" Style="{StaticResource LightboxToolbarBtn}" Click="BtnZoomFit_Click" Margin="0,0,4,0" ToolTip="Tự co dãn vừa màn hình (Phím F hoặc 0)"/>
                        <Button Content="1:1 (100%)" Style="{StaticResource LightboxToolbarBtn}" Click="BtnZoom100_Click" Margin="0,0,4,0" ToolTip="Kích thước thật 1:1 (Phím 1)"/>
                        <Button Content="↺ Đặt Lại" Style="{StaticResource LightboxToolbarBtn}" Click="BtnResetAllCustomItems_Click" Margin="0,0,4,0" ToolTip="Khôi phục toàn bộ vị trí Aptomat, Đèn báo, PM về vị trí lưới chuẩn mặc định"/>
                        <Button x:Name="btnTogglePanMode" Content="✋ Kéo Trượt" Style="{StaticResource LightboxToolbarBtn}" Click="BtnTogglePanMode_Click" Margin="0,0,4,0" ToolTip="Bật/Tắt chế độ kéo trượt bằng chuột trái"/>
                        <Button x:Name="btnToggleCadTheme" Content="🌓 Đổi Nền" Style="{StaticResource LightboxToolbarBtn}" Click="BtnToggleCadTheme_Click" ToolTip="Chuyển đổi màu nền xem (Tối / Sáng)"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- VÙNG HIỂN THỊ PREVIEW CANVAS TRONG LIGHTBOX -->
            <Border Grid.Row="1" Background="#12161F" BorderBrush="#333D54" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <ScrollViewer x:Name="lightboxScrollViewer" 
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Background="#12161F"
                                  PreviewMouseDown="PreviewScrollViewer_PreviewMouseDown"
                                  PreviewMouseMove="PreviewScrollViewer_PreviewMouseMove"
                                  PreviewMouseUp="PreviewScrollViewer_PreviewMouseUp"
                                  PreviewMouseWheel="PreviewScrollViewer_PreviewMouseWheel">
                    </ScrollViewer>

                    <!-- Skeleton / Loading Spinner -->
                    <Border x:Name="pnlLightboxLoading" Background="#B312161F" CornerRadius="8" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="180" Height="5" Foreground="#00E5FF" Background="#2A3246" BorderThickness="0"/>
                            <TextBlock Text="⚡ Đang dựng chi tiết sơ đồ nguyên lý..." FontSize="12" Foreground="#00E5FF" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- BOTTOM STATUS / HINT BAR -->
            <Border Grid.Row="2" Background="#1E2433" CornerRadius="6" Padding="10,6" Margin="0,8,0,0" BorderBrush="#333D54" BorderThickness="1">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="💡 Phím tắt: [ESC] Thoát Lightbox • [← / →] Chuyển Tủ • [+ / −] Phóng To/Thu Nhỏ • [F] Vừa Khung • [1] 100% • Giữ chuột giữa / trái để Pan" 
                               FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>

</Grid>

</Window>