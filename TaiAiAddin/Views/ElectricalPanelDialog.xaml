<Window x:Class="TaiAiAddin.Views.ElectricalPanelDialog"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

        mc:Ignorable="d"

        Title="NTT TOOLS - Thiết Kế Sơ Đồ Nguyên Lý Tủ Điện HVAC &amp; Cân Pha Tự Động" 

        Height="820" Width="1360" MinHeight="660" MinWidth="1050"

        WindowStartupLocation="CenterScreen"

        FontFamily="Segoe UI" FontSize="12" Background="#F4F6F9"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>

        <!-- Dark Mode High-Contrast ComboBox Styles (Chuẩn Dark Mode RGB & Accessibility WCAG AAA) -->
        <ControlTemplate x:Key="SldDarkComboBoxToggleButton" TargetType="ToggleButton">
            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="22" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="5"
                        Background="#1E2433" BorderBrush="#333D54" BorderThickness="1.2" />
                <Path x:Name="Arrow" Grid.Column="1" Fill="#00E5FF" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M 0 0 L 4 4 L 8 0 Z" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#00E5FF" />
                    <Setter TargetName="Border" Property="Background" Value="#2A3246" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#00E5FF" />
                    <Setter TargetName="Border" Property="Background" Value="#2A3246" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="SldDarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="Background" Value="#1E2433" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A3246" />
                                <Setter Property="TextElement.Foreground" Value="#00E5FF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A3246" />
                                <Setter Property="TextElement.Foreground" Value="#00E5FF" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SldDarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="TextElement.Foreground" Value="#F8FAFC" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SldDarkComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid HorizontalAlignment="Stretch">
                            <ToggleButton Name="ToggleButton" Template="{StaticResource SldDarkComboBoxToggleButton}" 
                                          Focusable="False" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press" HorizontalAlignment="Stretch" />
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" 
                                              TextElement.Foreground="#F8FAFC"
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="8,2,24,2" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="220" Margin="0,3,0,0">
                                    <Border Name="DropDownBorder" Background="#1E2433" BorderBrush="#00E5FF" BorderThickness="1.2" CornerRadius="5">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Floating Shadow Effect for Lightbox Toolbar & Cards -->
        <DropShadowEffect x:Key="FloatingShadow" BlurRadius="20" Color="#000000" Opacity="0.45" ShadowDepth="4"/>

        <!-- Lightbox Close Button Style -->
        <Style x:Key="LightboxCloseBtn" TargetType="Button">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EF4444"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Lightbox Toolbar Button Style -->
        <Style x:Key="LightboxToolbarBtn" TargetType="Button">
            <Setter Property="Background" Value="#2A3246"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#333D54"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#38435C"/>
                    <Setter Property="BorderBrush" Value="#00E5FF"/>
                    <Setter Property="Foreground" Value="#00E5FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Side Preview Mini Button Style -->
        <Style x:Key="SidePreviewMiniBtn" TargetType="Button">
            <Setter Property="Background" Value="#2A3246"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#38435C"/>
                    <Setter Property="Foreground" Value="#00E5FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Side Preview Close Button Style -->
        <Style x:Key="SidePreviewCloseBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">

            <Setter Property="Background" Value="#007ACC" />

            <Setter Property="Foreground" Value="White" />

            <Setter Property="FontWeight" Value="SemiBold" />

            <Setter Property="Padding" Value="12,6" />

            <Setter Property="BorderThickness" Value="0" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Background" Value="#005A9E" />

                </Trigger>

            </Style.Triggers>

        </Style>

        <Style x:Key="SuccessBtn" TargetType="Button">

            <Setter Property="Background" Value="#28A745" />

            <Setter Property="Foreground" Value="White" />

            <Setter Property="FontWeight" Value="SemiBold" />

            <Setter Property="Padding" Value="14,8" />

            <Setter Property="BorderThickness" Value="0" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Background" Value="#218838" />

                </Trigger>

            </Style.Triggers>

        </Style>

        <Style x:Key="PurpleBtn" TargetType="Button">

            <Setter Property="Background" Value="#6A1B9A" />

            <Setter Property="Foreground" Value="White" />

            <Setter Property="FontWeight" Value="Bold" />

            <Setter Property="Padding" Value="14,8" />

            <Setter Property="BorderThickness" Value="0" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Background" Value="#7B1FA2" />

                </Trigger>

            </Style.Triggers>

        </Style>

        <Style x:Key="OutlineBtn" TargetType="Button">

            <Setter Property="Background" Value="White" />

            <Setter Property="Foreground" Value="#333" />

            <Setter Property="Padding" Value="8,5" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="BorderBrush" Value="#CCC" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 

                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Background" Value="#F0F4F8" />

                </Trigger>

            </Style.Triggers>

        </Style>

        <Style x:Key="CardStyle" TargetType="Border">

            <Setter Property="Background" Value="White" />

            <Setter Property="CornerRadius" Value="6" />

            <Setter Property="BorderBrush" Value="#E1E4E8" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="Padding" Value="10" />

            <Setter Property="Margin" Value="0,0,0,8" />

        </Style>

    </Window.Resources>

    <Grid>
        <!-- NỘI DUNG CHÍNH DIALOG (BẢO TOÀN NGỮ CẢNH) -->
        <Grid Margin="14">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto" /> <!-- Header thông tin tủ & chọn tủ -->

            <RowDefinition Height="*" />    <!-- Content chia 2 Tab: Grid & Preview -->

            <RowDefinition Height="Auto" /> <!-- Bottom Action Buttons -->

        </Grid.RowDefinitions>

        <!-- 1. HEADER: QUẢN LÝ NHIỀU TỦ & CẤU HÌNH TỦ ĐIỆN -->

        <Border Grid.Row="0" Style="{StaticResource CardStyle}">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>

                <!-- HÀNG 1: LOGO, TIÊU ĐỀ & CÁC NÚT TÍNH NĂNG CHÍNH -->

                <Grid Grid.Row="0" Margin="0,0,0,8">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto" />

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="Auto" />

                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                        <Border Width="34" Height="34" CornerRadius="6" Margin="0,0,8,0" VerticalAlignment="Center">

                            <Border.Background>

                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">

                                    <GradientStop Color="#007ACC" Offset="0"/>

                                    <GradientStop Color="#005A9E" Offset="1"/>

                                </LinearGradientBrush>

                            </Border.Background>

                            <TextBlock Text="NTT" Foreground="White" FontWeight="Black" FontSize="11" 

                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI Black, Impact, Arial Black"/>

                        </Border>

                        <StackPanel>

                            <TextBlock Text="NTT TOOLS - THIẾT KẾ SƠ ĐỒ NGUYÊN LÝ TỦ ĐIỆN" FontWeight="Bold" FontSize="13" Foreground="#1E1E1E" />

                            <TextBlock Text="Thiết kế / Shopdrawing / BKL • Cân pha tự động • Y-Δ/VFD/SS • Sụt áp TCVN • ATS • Riser" FontSize="11" Foreground="#666" />

                        </StackPanel>

                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                        <Button x:Name="btnImportExcel" Content="📥 Nhập Excel" 

                                Style="{StaticResource OutlineBtn}" Click="BtnImportExcel_Click" Margin="0,0,5,0" FontWeight="SemiBold" Foreground="#007ACC" ToolTip="Nhập danh sách tải từ file Excel (.xls) hoặc CSV"/>

                        <Button x:Name="btnExportSampleTemplate" Content="📄 Mẫu Excel" 

                                Style="{StaticResource OutlineBtn}" Click="BtnExportSampleTemplate_Click" Margin="0,0,5,0" FontWeight="SemiBold" ToolTip="Tạo file Excel mẫu chuẩn"/>

                        <Button x:Name="btnExportExcel" Content="📊 Xuất Excel (.xls)" 

                                Style="{StaticResource OutlineBtn}" Click="BtnExportExcel_Click" Margin="0,0,5,0" FontWeight="SemiBold" Foreground="#1E7E34" ToolTip="Xuất bảng tính tải và Sheet bóc tách BOQ"/>

                        <Button x:Name="btnDrawRiser" Content="🌳 Cây Riser" 

                                Style="{StaticResource OutlineBtn}" Click="BtnDrawRiser_Click" Margin="0,0,5,0" FontWeight="SemiBold" Foreground="#6A1B9A" ToolTip="Vẽ sơ đồ cây phân phối toàn công trình"/>

                        <Button x:Name="btnOptimizeVoltageDrop" Content="⚡ Tối Ưu Cáp" 

                                Style="{StaticResource OutlineBtn}" Click="BtnOptimizeVoltageDrop_Click" Margin="0,0,5,0" FontWeight="SemiBold" Foreground="#D9534F" ToolTip="Tự động tăng cỡ cáp nếu vượt sụt áp TCVN"/>

                        <Button x:Name="btnCalculate" Content="⚡ Cân Pha Tự Động" 

                                Style="{StaticResource PrimaryBtn}" Click="BtnCalculate_Click"/>

                    </StackPanel>

                </Grid>

                <!-- HÀNG 2: THANH QUẢN LÝ NHIỀU TỦ & THÔNG SỐ TỦ ĐANG CHỌN -->

                <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8,6">

                    <WrapPanel VerticalAlignment="Center">

                        <!-- Chọn tủ điện trong danh sách -->

                        <TextBlock Text="🗄️ Chọn Tủ:" FontWeight="Bold" Foreground="#005A9E" VerticalAlignment="Center" Margin="0,0,4,0"/>

                        <ComboBox x:Name="cboPanels" DisplayMemberPath="PanelName" SelectedValuePath="PanelName" Width="130" Height="26" VerticalContentAlignment="Center"

                                  SelectionChanged="CboPanels_SelectionChanged" FontWeight="Bold" Margin="0,0,4,0"/>

                        <!-- Thao tác tủ: Thêm, Nhân bản, Xóa -->

                        <Button x:Name="btnAddPanel" Content="➕ Thêm Tủ" Style="{StaticResource OutlineBtn}" Click="BtnAddPanel_Click" Margin="0,0,3,0" Padding="6,2"/>

                        <Button x:Name="btnClonePanel" Content="📋 Nhân Bản" Style="{StaticResource OutlineBtn}" Click="BtnClonePanel_Click" Margin="0,0,3,0" Padding="6,2"/>

                        <Button x:Name="btnDeletePanel" Content="🗑️ Xóa" Style="{StaticResource OutlineBtn}" Click="BtnDeletePanel_Click" Margin="0,0,12,0" Padding="6,2" Foreground="#C82333"/>

                        <!-- Tên tủ điện -->

                        <TextBlock Text="Tên Tủ:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>

                        <TextBox x:Name="txtPanelName" Text="DB-HVAC-01" Width="105" Height="26" VerticalContentAlignment="Center" 

                                 FontWeight="Bold" Padding="4,0" TextChanged="TxtPanelName_TextChanged" Margin="0,0,8,0"/>

                        <!-- Hệ số đồng thời Kdt -->

                        <TextBlock Text="Kđt:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>

                        <TextBox x:Name="txtKdt" Text="0.85" Width="36" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="0,0,8,0"/>

                        <!-- Cos(phi) -->

                        <TextBlock Text="Cosφ:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>

                        <TextBox x:Name="txtCosPhi" Text="0.85" Width="36" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="0,0,8,0"/>

                        <!-- Loại cáp mặc định cho toàn tủ -->

                        <TextBlock Text="Loại Cáp Tủ:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>

                        <ComboBox x:Name="cmbDefaultCableType" Width="110" Height="26" VerticalContentAlignment="Center"

                                  SelectionChanged="CmbDefaultCableType_SelectionChanged" FontWeight="SemiBold" FontSize="11">

                            <ComboBoxItem Content="Cu/XLPE/PVC" Tag="Cu/XLPE/PVC" IsSelected="True"/>

                            <ComboBoxItem Content="Cu/PVC/PVC" Tag="Cu/PVC/PVC"/>

                            <ComboBoxItem Content="Cu/PVC" Tag="Cu/PVC"/>

                        </ComboBox>

                        <!-- Nguồn vào Incomer -->

                        <TextBlock Text="Nguồn:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,4,0"/>

                        <ComboBox x:Name="cboIncomer" Width="105" Height="26" VerticalContentAlignment="Center"

                                  SelectionChanged="CboIncomer_SelectionChanged" FontWeight="SemiBold" FontSize="11">

                            <ComboBoxItem Content="1 Nguồn EVN" Tag="SingleNormal" IsSelected="True"/>

                            <ComboBoxItem Content="2 Nguồn ATS" Tag="DualATS"/>

                            <ComboBoxItem Content="Liên Động 2 CB" Tag="DualInterlock"/>

                        </ComboBox>

                        <!-- Tụ bù -->

                        <CheckBox x:Name="chkHasCapacitor" Content="Tụ Bù" IsChecked="False" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,6,0"

                                  Checked="ChkCapacitor_Changed" Unchecked="ChkCapacitor_Changed" Foreground="#0277BD" ToolTip="Tính chọn và vẽ lộ Tụ bù công suất phản kháng"/>

                        <!-- Bảng chú thích ký hiệu -->

                        <CheckBox x:Name="chkIncludeLegend" Content="Bảng Chú Thích" IsChecked="False" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"

                                  Checked="ChkLegend_Changed" Unchecked="ChkLegend_Changed" Foreground="#D84315" ToolTip="Tùy chọn xuất bảng chú thích ký hiệu block (CB, MCCB, MCB, DOL, SS, FUSE,...)"/>

                        <!-- Khung A3 -->

                        <CheckBox x:Name="chkIncludeTitleBlock" Content="Khung Tên A3" IsChecked="False" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"

                                  Checked="ChkTitleBlock_Changed" Unchecked="ChkTitleBlock_Changed" Foreground="#333" ToolTip="Lồng khung bản vẽ kỹ thuật A3 (HT - Khung ten A3-HE DIEN.dwg)"/>

                        <!-- Mặt ngoài tủ riêng (Sheet 02) -->

                        <CheckBox x:Name="chkDrawFrontView" Content="Mặt Ngoài Tủ (Sheet 02)" IsChecked="False" FontWeight="SemiBold" VerticalAlignment="Center"

                                  Checked="ChkFrontView_Changed" Unchecked="ChkFrontView_Changed" Foreground="#7B1FA2" ToolTip="Xuất bản vẽ riêng biệt cho Mặt ngoài vỏ tủ (Sheet 02) kèm khung tên và bảng thông số"/>

                    </WrapPanel>

                </Border>

            </Grid>

        </Border>

        <!-- 2. NỘI DUNG CHÍNH (TAB CONTROL: BẢNG DỮ LIỆU & PREVIEW SƠ ĐỒ TRỰC QUAN) -->

        <TabControl x:Name="mainTabControl" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="MainTabControl_SelectionChanged">

            <!-- TAB 1: BẢNG DỮ LIỆU & THÔNG SỐ TÍNH TOÁN -->

            <TabItem Header="📋 Danh Sách Phụ Tải &amp; Bộ DOL / Cáp / CB">

                <Grid Margin="0,8,0,0">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>

                    <!-- Thanh công cụ thêm/bớt phụ tải & Điều khiển Side-Panel / Lightbox -->

                    <Border Grid.Row="0" Background="#F0F4F8" Padding="6,6" CornerRadius="4" Margin="0,0,0,6">

                        <DockPanel LastChildFill="True">

                            <!-- Nhóm nút Phóng To & Side-Panel góc phải -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">

                                <Button x:Name="btnToggleSidePreview" Content="👁️ Xem Nhanh Side-Panel" 
                                        Style="{StaticResource PrimaryBtn}" Background="#00838F" 
                                        Click="BtnToggleSidePreview_Click" Margin="0,0,6,0"
                                        ToolTip="Mở bảng Preview xem trước sơ đồ nguyên lý ngay bên cạnh DataGrid (Bảo toàn vị trí nhập liệu)"/>

                                <Button x:Name="btnOpenLightboxFromTab1" Content="⛶ Phóng To Lightbox" 
                                        Style="{StaticResource OutlineBtn}" FontWeight="SemiBold" Foreground="#007ACC"
                                        Click="BtnOpenLightbox_Click" Margin="0,0,0,0"
                                        ToolTip="Phóng to sơ đồ nguyên lý toàn màn hình (Hỗ trợ phím ESC hoặc click ngoài để đóng)"/>

                                <Button x:Name="btnQuickSldV2" Content="⚡ Sang Tab SDL V2 (MCC)" 
                                        Style="{StaticResource OutlineBtn}" FontWeight="Bold" Foreground="#FF9100" BorderBrush="#FF9100"
                                        Click="BtnQuickSldV2_Click" Margin="6,0,0,0"
                                        ToolTip="Chuyển nhanh sang Tab Cấu hình Động Lực MCC V2 (Cấp nguồn từ dưới lên &amp; Tín hiệu PCCC/BMS)"/>

                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                <Button x:Name="btnAddRow3P" Content="➕ Thêm Tải 3 Pha" Style="{StaticResource OutlineBtn}" Click="BtnAddRow3P_Click" Margin="0,0,6,0"/>

                                <Button x:Name="btnAddRow1P" Content="➕ Thêm Tải 1 Pha" Style="{StaticResource OutlineBtn}" Click="BtnAddRow1P_Click" Margin="0,0,6,0"/>

                                <Button x:Name="btnAddSpare3P" Content="➕ Dự Phòng 3P" Style="{StaticResource OutlineBtn}" Click="BtnAddSpare3P_Click" Margin="0,0,6,0" Foreground="#007ACC" FontWeight="SemiBold"/>

                                <Button x:Name="btnAddSpare1P" Content="➕ Dự Phòng 1P" Style="{StaticResource OutlineBtn}" Click="BtnAddSpare1P_Click" Margin="0,0,8,0" Foreground="#2E7D32" FontWeight="SemiBold"/>

                                <Button x:Name="btnDeleteRow" Content="🗑️ Xóa Phụ Tải" Style="{StaticResource OutlineBtn}" Click="BtnDeleteRow_Click" Margin="0,0,10,0"/>

                                <TextBlock Text="* 3P (Đỏ) • 1P (Xanh lá) • DOL/Y-Δ/VFD/SS • Sụt áp &gt; 2.5% cảnh báo đỏ" VerticalAlignment="Center" Foreground="#555" FontSize="11" FontStyle="Italic"/>

                            </StackPanel>

                        </DockPanel>

                    </Border>

                    <!-- Khung phân chia hiển thị: Bảng DataGrid & Side-Panel Preview -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="colDataGrid" Width="*" MinWidth="450"/>
                            <ColumnDefinition x:Name="colSplitter" Width="Auto"/>
                            <ColumnDefinition x:Name="colSidePreview" Width="0" MinWidth="0"/>
                        </Grid.ColumnDefinitions>

                        <!-- Bảng DataGrid hiển thị và chỉnh sửa phụ tải -->
                        <DataGrid Grid.Column="0" x:Name="dgLoads" AutoGenerateColumns="False" CanUserAddRows="False"

                              GridLinesVisibility="All" HorizontalGridLinesBrush="#E1E4E8" VerticalGridLinesBrush="#E1E4E8"

                              HeadersVisibility="Column" Background="White" RowHeight="28" FontSize="11"

                              SelectionMode="Single" CellEditEnding="DgLoads_CellEditEnding">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="STT" Binding="{Binding Stt}" Width="35" IsReadOnly="True"/>

                            <DataGridTextColumn Header="Tên Phụ Tải / Load Name" Binding="{Binding LoadName}" Width="150"/>

                            <!-- Cột Loại Tải (Motor, Cấp nguồn tủ, Chiếu sáng, v.v.) -->
                            <DataGridTemplateColumn Header="Loại Tải" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LoadType}" Foreground="{Binding LoadTypeBrush}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding LoadType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Tag" Height="22" VerticalContentAlignment="Center" FontSize="11">
                                            <ComboBoxItem Content="Động cơ" Tag="Động cơ" Foreground="#0288D1" FontWeight="SemiBold"/>
                                            <ComboBoxItem Content="Cấp nguồn tủ" Tag="Cấp nguồn tủ" Foreground="#7B1FA2" FontWeight="SemiBold"/>
                                            <ComboBoxItem Content="Chiếu sáng" Tag="Chiếu sáng" Foreground="#F57C00" FontWeight="SemiBold"/>
                                            <ComboBoxItem Content="Ổ cắm" Tag="Ổ cắm" Foreground="#388E3C" FontWeight="SemiBold"/>
                                            <ComboBoxItem Content="Tải khác" Tag="Tải khác" Foreground="#546E7A" FontWeight="SemiBold"/>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridCheckBoxColumn Header="Dự Phòng" Binding="{Binding IsSpare, UpdateSourceTrigger=PropertyChanged}" Width="65"/>

                            <DataGridCheckBoxColumn Header="Vẽ Dây Ra" Binding="{Binding DrawOutgoingWire, UpdateSourceTrigger=PropertyChanged}" Width="68"/>

                            <!-- Cột Loại Pha -->

                            <DataGridTemplateColumn Header="Loại Pha" Width="75">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <TextBlock Text="{Binding PhaseDisplay}" 

                                                   Foreground="{Binding PhaseColorBrush}" 

                                                   FontWeight="Bold" 

                                                   VerticalAlignment="Center" 

                                                   HorizontalAlignment="Center"/>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                                <DataGridTemplateColumn.CellEditingTemplate>

                                    <DataTemplate>

                                        <ComboBox SelectedValue="{Binding PhaseDisplay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"

                                                  SelectedValuePath="Tag" Height="24" VerticalContentAlignment="Center">

                                            <ComboBoxItem Content="3 Pha" Tag="3 Pha" Foreground="#D32F2F" FontWeight="Bold"/>

                                            <ComboBoxItem Content="1 Pha" Tag="1 Pha" Foreground="#2E7D32" FontWeight="Bold"/>

                                        </ComboBox>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellEditingTemplate>

                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Tổng P (kW)" Binding="{Binding PowerKW, StringFormat={}{0:0.###}, UpdateSourceTrigger=LostFocus}" Width="75"/>

                            <DataGridTextColumn Header="Số Mạch" Binding="{Binding CircuitNumber}" Width="55" IsReadOnly="True"/>

                            <DataGridTextColumn Header="Pha (R)" Binding="{Binding PowerR, StringFormat={}{0:0.###}, UpdateSourceTrigger=LostFocus}" Width="55"/>

                            <DataGridTextColumn Header="Pha (Y)" Binding="{Binding PowerY, StringFormat={}{0:0.###}, UpdateSourceTrigger=LostFocus}" Width="55"/>

                            <DataGridTextColumn Header="Pha (B)" Binding="{Binding PowerB, StringFormat={}{0:0.###}, UpdateSourceTrigger=LostFocus}" Width="55"/>

                            <DataGridTextColumn Header="Dòng Itt (A)" Binding="{Binding CurrentA, StringFormat={}{0:N1}}" Width="70" IsReadOnly="True"/>

                            <!-- Cột Loại Aptomat (MCCB / MCB / RCCB / RCBO) -->

                            <DataGridTemplateColumn Header="Loại CB" Width="110">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <ComboBox SelectedValue="{Binding BreakerType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"

                                                  SelectedValuePath="Tag" Height="22" VerticalContentAlignment="Center" FontSize="11">

                                            <ComboBoxItem Content="MCB 1P" Tag="MCB 1P" Foreground="#2E7D32" FontWeight="SemiBold"/>

                                            <ComboBoxItem Content="MCB 2P" Tag="MCB 2P" Foreground="#2E7D32" FontWeight="Bold"/>

                                            <ComboBoxItem Content="MCB 3P" Tag="MCB 3P" Foreground="#2E7D32" FontWeight="Bold"/>

                                            <ComboBoxItem Content="MCB 4P" Tag="MCB 4P" Foreground="#2E7D32" FontWeight="Bold"/>

                                            <ComboBoxItem Content="MCCB 1P" Tag="MCCB 1P" Foreground="#005A9E" FontWeight="SemiBold"/>

                                            <ComboBoxItem Content="MCCB 2P" Tag="MCCB 2P" Foreground="#005A9E" FontWeight="Bold"/>

                                            <ComboBoxItem Content="MCCB 3P" Tag="MCCB 3P" Foreground="#005A9E" FontWeight="Bold"/>

                                            <ComboBoxItem Content="MCCB 4P" Tag="MCCB 4P" Foreground="#005A9E" FontWeight="Bold"/>

                                            <ComboBoxItem Content="RCCB 2P (30mA)" Tag="RCCB 2P" Foreground="#D84315" FontWeight="Bold"/>

                                            <ComboBoxItem Content="RCCB 4P (30mA)" Tag="RCCB 4P" Foreground="#D84315" FontWeight="Bold"/>

                                            <ComboBoxItem Content="RCBO 2P (30mA)" Tag="RCBO 2P" Foreground="#E65100" FontWeight="Bold"/>

                                            <ComboBoxItem Content="RCBO 4P (30mA)" Tag="RCBO 4P" Foreground="#E65100" FontWeight="Bold"/>

                                        </ComboBox>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                            <!-- Cột Thông Số Aptomat (Cho phép chỉnh sửa tùy biến) -->

                            <DataGridTextColumn Header="Thông Số CB" Binding="{Binding BreakerSpec, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="140"/>

                            <!-- Cột Bộ Khởi Động -->

                            <DataGridTemplateColumn Header="Khởi Động" Width="85">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <TextBlock Text="{Binding StarterDisplay}" FontWeight="Bold" Foreground="#E65100" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                                <DataGridTemplateColumn.CellEditingTemplate>

                                    <DataTemplate>

                                        <ComboBox SelectedValue="{Binding StarterDisplay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"

                                                  SelectedValuePath="Tag" Height="22" VerticalContentAlignment="Center" FontSize="11">

                                            <ComboBoxItem Content="-" Tag="-"/>

                                            <ComboBoxItem Content="DOL" Tag="DOL" FontWeight="Bold" Foreground="#E65100"/>

                                            <ComboBoxItem Content="Y - Δ (2x3C)" Tag="Y - Δ" FontWeight="Bold" Foreground="#007ACC"/>

                                            <ComboBoxItem Content="VFD Biến Tần" Tag="VFD" FontWeight="Bold" Foreground="#2E7D32"/>

                                            <ComboBoxItem Content="Soft Starter" Tag="Soft Starter" FontWeight="Bold" Foreground="#6A1B9A"/>

                                        </ComboBox>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellEditingTemplate>

                            </DataGridTemplateColumn>

                                                        <!-- Cột Chế Độ Điều Khiển -->
                            <DataGridTemplateColumn Header="Điều Khiển" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ControlDisplay}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#005A9E"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ControlDisplay}" Value="BMS">
                                                            <Setter Property="Foreground" Value="#00838F"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ControlDisplay}" Value="PLC">
                                                            <Setter Property="Foreground" Value="#E65100"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ControlDisplay}" Value="TIMER">
                                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding ControlDisplay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Tag" Height="22" VerticalContentAlignment="Center" FontSize="11">
                                            <ComboBoxItem Content="-" Tag="-"/>
                                            <ComboBoxItem Content="A-O-M" Tag="A-O-M" FontWeight="Bold" Foreground="#005A9E"/>
                                            <ComboBoxItem Content="Phao (FS)" Tag="Phao (FS)" FontWeight="Bold" Foreground="#0277BD"/>
                                            <ComboBoxItem Content="Áp suất (PS)" Tag="Áp suất (PS)" FontWeight="Bold" Foreground="#D81B60"/>
                                            <ComboBoxItem Content="BMS" Tag="BMS" FontWeight="Bold" Foreground="#00838F"/>
                                            <ComboBoxItem Content="PLC" Tag="PLC" FontWeight="Bold" Foreground="#E65100"/>
                                            <ComboBoxItem Content="TIMER" Tag="TIMER" FontWeight="Bold" Foreground="#2E7D32"/>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <!-- Cột Nhóm Điều Khiển (Áp dụng duy nhất cho BMS, PLC, TIMER) -->
                            <DataGridTemplateColumn Header="Nhóm ĐK" Width="68">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsControlGrouped, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanGroupControl}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  ToolTip="Tích chọn để gom nhóm chung đường trục Trunk line (chỉ hỗ trợ BMS/PLC/TIMER)"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Cột Chiều Dài L (m) -->

                            <DataGridTextColumn Header="Dài L (m)" Binding="{Binding CableLength, StringFormat={}{0:0.#}, UpdateSourceTrigger=LostFocus}" Width="60"/>

                            <!-- Cột Sụt Áp ΔU % -->

                            <DataGridTemplateColumn Header="Sụt Áp ΔU" Width="70">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <TextBlock Text="{Binding VoltageDropDisplay}" 

                                                   Foreground="{Binding VoltageDropColorBrush}" 

                                                   FontWeight="Bold" 

                                                   HorizontalAlignment="Right" 

                                                   VerticalAlignment="Center"/>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                            <!-- Cột Loại Dây Cáp -->

                            <DataGridTemplateColumn Header="Loại Dây" Width="105">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <ComboBox SelectedValue="{Binding CableType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"

                                                  SelectedValuePath="Tag" Height="22" VerticalContentAlignment="Center" FontSize="11">

                                            <ComboBoxItem Content="Cu/XLPE/PVC" Tag="Cu/XLPE/PVC" FontWeight="SemiBold"/>

                                            <ComboBoxItem Content="Cu/PVC/PVC" Tag="Cu/PVC/PVC" FontWeight="SemiBold"/>

                                            <ComboBoxItem Content="Cu/PVC" Tag="Cu/PVC" FontWeight="SemiBold"/>

                                        </ComboBox>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                            <!-- Cột Số Lõi (1C, 2C, 3C, 4C) -->

                            <DataGridTemplateColumn Header="Số Lõi" Width="75">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <ComboBox SelectedValue="{Binding CoreType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"

                                                  SelectedValuePath="Tag" Height="22" VerticalContentAlignment="Center" FontSize="11">

                                            <ComboBoxItem Content="Tự động" Tag="Auto"/>

                                            <ComboBoxItem Content="1C" Tag="1C" FontWeight="Bold"/>

                                            <ComboBoxItem Content="2C" Tag="2C" FontWeight="Bold"/>

                                            <ComboBoxItem Content="3C" Tag="3C" FontWeight="Bold"/>

                                            <ComboBoxItem Content="4C" Tag="4C" FontWeight="Bold"/>

                                            <ComboBoxItem Content="4x1C" Tag="4x1C"/>

                                            <ComboBoxItem Content="3x1C" Tag="3x1C"/>

                                            <ComboBoxItem Content="2x1C" Tag="2x1C"/>

                                        </ComboBox>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                            <!-- Cột Tiết Diện Cáp Đầy Đủ (cho phép sửa tay nếu muốn) -->

                            <DataGridTextColumn Header="Tiết Diện Dây Cáp (Đầy Đủ + PE)" Binding="{Binding FullCableString, UpdateSourceTrigger=LostFocus}" Width="*"/>

                        </DataGrid.Columns>

                    </DataGrid>

                        <!-- Splitter kéo co dãn kích thước giữa Bảng và Side-panel -->
                        <GridSplitter Grid.Column="1" x:Name="sidePreviewSplitter" Width="6" 
                                      Background="#CBD5E1" HorizontalAlignment="Center" 
                                      VerticalAlignment="Stretch" Visibility="Collapsed" 
                                      ShowsPreview="True" Cursor="SizeWE"/>

                        <!-- VÙNG SIDE-PANEL PREVIEW SƠ ĐỒ (BẢO TOÀN NGỮ CẢNH NHẬP LIỆU) -->
                        <Border Grid.Column="2" x:Name="sidePreviewPanel" Background="#12161F" 
                                BorderBrush="#333D54" BorderThickness="1" CornerRadius="6" 
                                Margin="6,0,0,0" Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Header bar -->
                                    <RowDefinition Height="*"/>    <!-- Canvas ScrollViewer -->
                                    <RowDefinition Height="Auto"/> <!-- Bottom bar -->
                                </Grid.RowDefinitions>

                                <!-- Header bar -->
                                <Border Grid.Row="0" Background="#1E2433" CornerRadius="5,5,0,0" Padding="6,4" BorderBrush="#333D54" BorderThickness="0,0,0,1">
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="↺ Đặt Lại" Style="{StaticResource SidePreviewMiniBtn}" Click="BtnResetAllCustomItems_Click" ToolTip="Khôi phục toàn bộ vị trí Aptomat, Đèn báo, PM về vị trí lưới chuẩn (Reset Move/Rotate/Scale)"/>
                                            <Button Content="⛶ Vừa Khung" Style="{StaticResource SidePreviewMiniBtn}" Click="BtnZoomFit_Click" ToolTip="Tự co dãn vừa khung nhìn (Phím F)"/>
                                            <Button Content="⛶ Toàn Màn Hình" Style="{StaticResource SidePreviewMiniBtn}" Background="#00838F" Foreground="White" Click="BtnOpenLightbox_Click" ToolTip="Mở Lightbox toàn màn hình"/>
                                            <Button Content="✕" Style="{StaticResource SidePreviewCloseBtn}" Click="BtnToggleSidePreview_Click" ToolTip="Đóng Side-Panel"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⚡ PREVIEW" FontWeight="Bold" FontSize="11" Foreground="#00E5FF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="txtSidePanelTitle" Text="Tủ: ..." FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0" MaxWidth="100" TextTrimming="CharacterEllipsis"/>
                                            
                                            <Separator Width="1" Height="14" Background="#333D54" Margin="0,0,6,0"/>

                                            <!-- KIỂU SLD -->
                                            <TextBlock Text="Kiểu:" FontSize="10.5" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <ComboBox x:Name="cboSideLayoutScheme" Style="{StaticResource SldDarkComboBoxStyle}" Width="140" Height="22" SelectionChanged="CboSideLayoutScheme_SelectionChanged" 
                                                      Margin="0,0,8,0" ToolTip="Chọn Kiểu Bố Cục Sơ Đồ Nguyên Lý">
                                                <ComboBoxItem Content="📐 Layout Basic (Bảng)" IsSelected="True"/>
                                                <ComboBoxItem Content="⚡ Miền Nam (IEC)"/>
                                                <ComboBoxItem Content="⭐ Miền Bắc (TCVN)"/>
                                                <ComboBoxItem Content="⚡ SDNL V2 (MCC)"/>
                                            </ComboBox>

                                            <!-- DẠNG SLD -->
                                            <TextBlock Text="Dạng:" FontSize="10.5" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <ComboBox x:Name="cboSideTreeOrientation" Style="{StaticResource SldDarkComboBoxStyle}" Width="105" Height="22" SelectionChanged="CboSideTreeOrientation_SelectionChanged" 
                                                      ToolTip="Chọn Hướng / Dạng Cây Phân Cấp">
                                                <ComboBoxItem Content="⬇️ Cây Đứng" IsSelected="True"/>
                                                <ComboBoxItem Content="➡️ Cây Ngang"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Canvas ScrollViewer -->
                                <ScrollViewer Grid.Row="1" x:Name="sidePreviewScrollViewer" 
                                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                              Background="#12161F"
                                              PreviewMouseDown="PreviewScrollViewer_PreviewMouseDown"
                                              PreviewMouseMove="PreviewScrollViewer_PreviewMouseMove"
                                              PreviewMouseUp="PreviewScrollViewer_PreviewMouseUp"
                                              PreviewMouseWheel="PreviewScrollViewer_PreviewMouseWheel">
                                </ScrollViewer>

                                <!-- Loading spinner -->
                                <Border Grid.Row="1" x:Name="pnlSideLoading" Background="#B312161F" Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ProgressBar IsIndeterminate="True" Width="120" Height="4" Foreground="#00E5FF" Background="#2A3246" BorderThickness="0"/>
                                        <TextBlock Text="⚡ Đang tính toán &amp; dựng sơ đồ..." FontSize="10" Foreground="#00E5FF" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Bottom status & hint -->
                                <Border Grid.Row="2" Background="#1E2433" Padding="6,4" CornerRadius="0,0,5,5" BorderBrush="#333D54" BorderThickness="0,1,0,0">
                                    <TextBlock Text="💡 Cập nhật tức thì khi chỉnh DataGrid • Lăn chuột: Zoom • Chuột giữa: Pan" 
                                               FontSize="9.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Thẻ Tổng Hợp Thông Số Tủ (Summary Card) -->

                    <Border Grid.Row="2" Background="#E8F4FD" CornerRadius="6" BorderBrush="#BEE3F8" BorderThickness="1" Padding="12,8" Margin="0,8,0,0">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="1.2*"/>

                                <ColumnDefinition Width="1.1*"/>

                                <ColumnDefinition Width="1*"/>

                                <ColumnDefinition Width="1.4*"/>

                                <ColumnDefinition Width="1.8*"/>

                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Tổng Công Suất Đặt (Pđặt):" FontSize="11" Foreground="#555"/>

                                <TextBlock x:Name="lblInstalledPower" Text="0.00 kW" FontWeight="Bold" FontSize="13" Foreground="#007ACC"/>

                                <TextBlock x:Name="lblPhaseDetail" Text="R: 0.0kW | Y: 0.0kW | B: 0.0kW" FontSize="10" FontWeight="SemiBold" Foreground="#333" Margin="0,2,0,0"/>

                            </StackPanel>

                            <StackPanel Grid.Column="1">

                                <TextBlock Text="Công Suất Tính Toán (Ptt):" FontSize="11" Foreground="#555"/>

                                <TextBlock x:Name="lblCalculatedPower" Text="0.00 kW" FontWeight="Bold" FontSize="13" Foreground="#D9534F"/>

                                <TextBlock x:Name="lblUnbalanceDetail" Text="Độ lệch pha: 0.0%" FontSize="10" FontWeight="SemiBold" Foreground="#D9534F" Margin="0,2,0,0"/>

                            </StackPanel>

                            <StackPanel Grid.Column="2">

                                <TextBlock Text="Dòng Điện Tổng (Itt):" FontSize="11" Foreground="#555"/>

                                <TextBlock x:Name="lblTotalCurrent" Text="0.00 A" FontWeight="Bold" FontSize="13" Foreground="#28A745"/>

                            </StackPanel>

                            <StackPanel Grid.Column="3">

                                <TextBlock Text="Aptomat Tổng (Main MCCB):" FontSize="11" Foreground="#555"/>

                                <TextBlock x:Name="lblMainBreaker" Text="MCCB 3P-36kA 800A" FontWeight="Bold" FontSize="13" Foreground="#1E1E1E"/>

                            </StackPanel>

                            <StackPanel Grid.Column="4">

                                <TextBlock Text="Cáp Nguồn Tổng (Main Cable):" FontSize="11" Foreground="#555"/>

                                <TextBlock x:Name="lblMainCable" Text="Cu/XLPE/PVC ..." FontWeight="Bold" FontSize="11.5" Foreground="#7B1FA2"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                </Grid>

            </TabItem>

            <!-- TAB 2: PREVIEW XEM TRƯỚC SƠ ĐỒ ĐƠN TUYẾN & TINH CHỈNH KÍCH THƯỚC -->

            <TabItem Header="📐 Preview Xem Trước Sơ Đồ Nguyên Lý">

                <Grid Margin="0,8,0,0">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <!-- THANH CẤU HÌNH KHỐI THIẾT BỊ PHỤ TRỢ & TINH CHỈNH KÍCH THƯỚC -->

                    <Border Grid.Row="0" Background="#F0F4F8" BorderBrush="#D1D9E0" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,6">

                        <StackPanel>

                            <!-- Hàng 0: Chọn Kiểu Bố Cục Sơ Đồ Nguyên Lý (3 Lựa Chọn Trực Quan) -->
                            <Border Background="#E8F4FD" BorderBrush="#B6E0FE" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,0,6">
                                <DockPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button x:Name="btnBrowseTemplate" Content="📁 Bản Vẽ Mẫu Đối Chiếu..." 
                                                Style="{StaticResource OutlineBtn}" Padding="8,2" FontSize="11" 
                                                Click="BtnBrowseTemplate_Click" ToolTip="Chọn file DWG bản vẽ mẫu đối chiếu chuẩn của công ty/ứng dụng"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
