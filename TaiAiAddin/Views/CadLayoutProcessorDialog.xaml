                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- GroupBox 2: Ngôn ngữ & Song ngữ hiển thị -->
                        <Border Style="{StaticResource DialogCardStyle}" Margin="0,0,0,12" Padding="14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="🌐 NGÔN NGỮ &amp; TÙY CHỌN SONG NGỮ (VIỆT - ANH - TRUNG)" FontWeight="Bold" FontSize="11.5" Foreground="#FF9100"/>
                                    <TextBlock Text="Tự động dịch thuật từ điển công năng phòng" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                                </DockPanel>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <RadioButton x:Name="rbLangVnOnly" GroupName="LanguageOptionGroup" Content="🇻🇳 Tiếng Việt (Thuần)" IsChecked="True" Foreground="#F8FAFC" Margin="0,0,0,8" Checked="RbLang_Checked"/>
                                        <RadioButton x:Name="rbLangVnEn" GroupName="LanguageOptionGroup" Content="🇬🇧 Song ngữ Việt - Anh (e.g. PHÒNG NGỦ / BEDROOM)" Foreground="#F8FAFC" Margin="0,0,0,8" Checked="RbLang_Checked"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <RadioButton x:Name="rbLangVnCn" GroupName="LanguageOptionGroup" Content="🇨🇳 Song ngữ Việt - Trung (e.g. PHÒNG NGỦ / 卧室)" Foreground="#F8FAFC" Margin="0,0,0,8" Checked="RbLang_Checked"/>
                                        <RadioButton x:Name="rbLangTri" GroupName="LanguageOptionGroup" Content="🌏 Đa ngữ Việt - Anh - Trung (3 Ngôn Ngữ)" Foreground="#F8FAFC" Checked="RbLang_Checked"/>
                                    </StackPanel>
                                </Grid>

                                <Border Background="#1E2433" CornerRadius="6" Padding="12,10" BorderBrush="#333D54" BorderThickness="1">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="💡 Mẫu hiển thị:" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Top" Margin="0,2,12,0" DockPanel.Dock="Left"/>
                                        <TextBlock x:Name="txtPreviewSampleText" Text="PHÒNG NGỦ&#x0a;S=24.50 m²" FontWeight="Bold" FontSize="11.5" Foreground="#00E676" LineHeight="18"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- GroupBox 3: Font chữ & Tiêu chuẩn hiển thị -->
                        <Border Style="{StaticResource DialogCardStyle}" Padding="14">
                            <StackPanel>
                                <TextBlock Text="🔤 TIÊU CHUẨN FONT CHỮ &amp; ĐỊNH DẠNG MTEXT" FontWeight="Bold" FontSize="11.5" Foreground="#00E676" Margin="0,0,0,10"/>
                                
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="TextStyle CAD:" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <TextBlock Text="AI_UNICODE_TEXT (Font Arial.ttf - Cam kết 100% tiếng Việt có dấu, không bao giờ lỗi font '???')" 
                                               Grid.Column="1" FontWeight="Bold" FontSize="10.5" Foreground="#00E5FF" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Quy cách nội dung:" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <TextBlock Text="Tên phòng nằm trên, Diện tích S nằm dưới • Riêng Hộp KT chỉ ghi tên Hộp KT, không ghi diện tích" 
                                               Grid.Column="1" FontWeight="Bold" FontSize="10.5" Foreground="#F8FAFC" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 4. KHỐI ĐÓNG GÓI BLOCK & RẢI NHÃN MTEXT (TÍNH NĂNG 6 & 7) -->
        <Border Grid.Row="3" Style="{StaticResource DialogCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="📦 ĐÓNG GÓI BLOCK &amp; RẢI NHÃN MTEXT TỰ ĐỘNG (TÍNH NĂNG 6 &amp; 7)" FontWeight="Bold" FontSize="11" Foreground="#FF9100"/>
                    <TextBlock Text="Tự động gom cụm nét cửa (Arc, Line, Polyline) thành Block AI_DOOR và rải Text diện tích tâm phòng" 
                               FontSize="10" Foreground="#94A3B8" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnPackageDoors" Content="📦 Đóng Gói Block Cửa (AI_DOOR)" Style="{StaticResource DarkBtnStyle}" 
                            Click="BtnPackageDoors_Click" Margin="0,0,6,0" ToolTip="Gom cụm nét cửa trên AI_XD_CUA và đóng thành Block INSERT"/>
                    <Button x:Name="btnAutoPlaceText" Content="🏷️ Rải Text Tự Động (Tâm Phòng)" Style="{StaticResource PrimaryCyanBtnStyle}" 
                            Click="BtnAutoPlaceText_Click" ToolTip="Rải MText Tên Phòng &amp; Diện tích S chuẩn mm vào tâm thông thủy"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 5. BOTTOM STATUS BAR & THOÁT -->
        <DockPanel Grid.Row="4" Margin="0,4,0,0">
            <TextBlock x:Name="txtDialogStatus" Text="Sẵn sàng. Vui lòng bấm Quét Khung Mặt Bằng để bắt đầu." 
                       FontSize="10" Foreground="#00E5FF" VerticalAlignment="Center"/>
            <Button Content="Đóng Cửa Sổ" Style="{StaticResource DarkBtnStyle}" Click="BtnClose_Click" HorizontalAlignment="Right" Padding="16,6"/>
        </DockPanel>
    </Grid>
</Window>
