                                    <Button x:Name="btnAiDrawCad" Content="✏️ Vẽ Lên CAD" Style="{StaticResource DarkBtnStyle}" 
                                            Click="BtnDrawBoundariesCad_Click" Margin="0,0,8,0" ToolTip="Vẽ các đường bao khép kín (LWPOLYLINE) và nhãn MText lên bản vẽ AutoCAD"/>
                                    <Button x:Name="btnAiExportTable" Content="📊 Xuất Bảng CAD Table" Style="{StaticResource DarkBtnStyle}" 
