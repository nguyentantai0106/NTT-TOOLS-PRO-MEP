                                        ToolTip="Nếu đang bật chế độ Bước 2: chỉ chuẩn hóa đúng mẫu vừa dạy (không đụng layer khác). Nếu tắt: chuẩn hóa toàn bản vẽ"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 5: CẤU HÌNH NHÃN TEXT & SONG NGỮ -->
            <TabItem x:Name="tabTextConfig" Header="⚙️ CẤU HÌNH NHÃN TEXT &amp; SONG NGỮ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Background="#161B26" Margin="12">
                        <!-- GroupBox 1: Cỡ chữ hiển thị -->
                        <Border Style="{StaticResource DialogCardStyle}" Margin="0,0,0,12" Padding="14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="📏 QUY CÁCH CỠ CHỮ HIỂN THỊ TRÊN BẢN VẼ" FontWeight="Bold" FontSize="11.5" Foreground="#00E5FF"/>
                                    <TextBlock Text="Đồng bộ cho mọi chức năng rải nhãn MText" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                                </DockPanel>

                                <!-- Tự động vs Thủ công -->
                                <StackPanel Margin="0,0,0,10">
                                    <RadioButton x:Name="rbAutoTextHeight" GroupName="TextHeightGroup" Content="Tự Động (Theo Chuẩn CĐT: 100mm cho WC, Ban công, Hộp KT • 200mm cho Phòng Ngủ, Khách, Bếp, Văn phòng)" 
                                                 IsChecked="True" Foreground="#F8FAFC" FontWeight="SemiBold" Margin="0,0,0,8" Checked="RbTextHeight_Checked"/>
                                    <RadioButton x:Name="rbManualTextHeight" GroupName="TextHeightGroup" Content="Thủ Công (Kỹ sư tự chỉ định kích thước chữ cho từng loại không gian)" 
                                                 Foreground="#F8FAFC" FontWeight="SemiBold" Checked="RbTextHeight_Checked"/>
