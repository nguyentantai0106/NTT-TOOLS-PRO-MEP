                                    <Button x:Name="btnAiClear" Content="🧹 Xóa Bao" Style="{StaticResource DarkBtnStyle}" 
                                            Click="BtnClearBoundaries_Click" ToolTip="Xóa các đường bao phòng hiện hành trên layer DUONG_BAO và DUONG_BAO_TEXT"/>
                                </StackPanel>
                                <TextBlock Text="💡 Toàn bộ tri thức GNN &amp; 9 Quy tắc hình học cốt lõi được áp dụng tự động 100%" 
