                                <TextBlock x:Name="txtAiKpiBanCong" Text="0 Ban Công" FontSize="14" FontWeight="Bold" Foreground="#E040FB" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Hàng 2: DataGrid danh sách phòng do AI bóc tách -->
                    <DataGrid Grid.Row="2" x:Name="dgAiRoomResults" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="200"
