<UserControl x:Class="TaiAiAddin.Views.Tabs.XlmbTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="360">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{DynamicResource FluidCardStyle}" Margin="0,0,0,8" HorizontalAlignment="Stretch">
        <StackPanel HorizontalAlignment="Stretch">
            <!-- HEADER VỚI BADGES MULTI-AGENT -->
            <DockPanel Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚡ THÔNG THỦY &amp; BAO PHÒNG AI" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentCyan}"/>
                    <Border Background="#FF00E676" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="CHỈ HUY TRƯỞNG" FontSize="8.5" FontWeight="Bold" Foreground="#12161F"/>
                    </Border>
                </StackPanel>
                <Border Background="{DynamicResource AccentCyan}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="MULTI-AGENT V2.6" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource BgPrimary}"/>
                </Border>
            </DockPanel>

            <!-- KHỐI ĐIỀU KHIỂN & TÙY CHỌN PHẠM VI -->
            <Border Style="{DynamicResource FluidSubCardStyle}">
                <StackPanel>
                    <TextBlock Text="🎯 TÙY CHỌN PHẠM VI BAO PHÒNG" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentCyan}" Margin="0,0,0,6"/>
                    <TextBlock Text="Chỉ Huy Trưởng AI tiếp nhận lệnh ngay tức thì, phân việc cho Agent kỹ thuật vẽ bao phòng và gán nhãn MText đi liền nét vẽ." 
                               FontSize="9.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <!-- 4 TÙY CHỌN PHẠM VI (CÓ THỂ CHỌN CẢ 4 HOẶC BẤT KỲ) -->
                    <Grid Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Row="0" Grid.Column="0" x:Name="chkScopeMain" Content="🏠 Phòng chính (Ngủ, Khách...)" IsChecked="True"
                                  Foreground="{DynamicResource TextPrimary}" FontSize="9.5" Margin="0,0,0,6"/>
                        <CheckBox Grid.Row="0" Grid.Column="1" x:Name="chkScopeCorridor" Content="🚶 Hành lang &amp; Sảnh" IsChecked="True"
                                  Foreground="{DynamicResource TextPrimary}" FontSize="9.5" Margin="0,0,0,6"/>
                        <CheckBox Grid.Row="1" Grid.Column="0" x:Name="chkScopeStair" Content="🛗 Hố thang máy &amp; Bộ" IsChecked="True"
                                  Foreground="{DynamicResource TextPrimary}" FontSize="9.5"/>
                        <CheckBox Grid.Row="1" Grid.Column="1" x:Name="chkScopeWc" Content="🚻 Nhà WC (Sàn âm -50mm)" IsChecked="True"
                                  Foreground="{DynamicResource TextPrimary}" FontSize="9.5"/>
                    </Grid>

                    <!-- NÚT HÀNH ĐỘNG CHÍNH: KÍCH HOẠT CHỈ HUY TRƯỞNG -->
                    <Button x:Name="btnExecuteXlmb" Content="⚡ KÍCH HOẠT CHỈ HUY TRƯỞNG MULTI-AGENT" 
                            Style="{DynamicResource PrimaryCyanButtonStyle}" Click="BtnExecuteXlmb_Click" 
                            Padding="6,8" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"
                            ToolTip="Chỉ Huy Trưởng tiếp nhận và điều phối đội ngũ Multi-Agent vẽ bao phòng tức thì lên CAD!"/>

                    <!-- HÀNG NÚT PHỤ: XUẤT BẢNG CAD & LÀM MỚI DỮ LIỆU & DỌN SẠCH -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="btnExportCadTable" Content="📊 Xuất Bảng CAD" 
                                Style="{DynamicResource DarkButtonStyle}" Click="BtnExportCadTable_Click"
                                Margin="0,0,4,0" ToolTip="Tạo thực thể AutoCAD Table thống kê diện tích phòng ngay trên bản vẽ"/>
                        <Button Grid.Column="1" x:Name="btnRefreshXlmbData" Content="🔄 Làm Mới Dữ Liệu" 
                                Style="{DynamicResource DarkButtonStyle}" Click="BtnRefreshXlmbData_Click"
                                Margin="0,0,4,0" ToolTip="Xóa sạch dữ liệu mặt bằng cũ và file đệm cũ"/>
                        <Button Grid.Column="2" x:Name="btnClearBoundary" Content="🧹 Xóa Nét" 
                                Style="{DynamicResource DangerButtonStyle}" Click="BtnClearBoundary_Click"
                                Padding="8,4" ToolTip="Xóa toàn bộ đường bao và nhãn text AI trên bản vẽ hiện tại"/>
                    </Grid>

                    <!-- THẺ TRẠNG THÁI & THỐNG KÊ NHANH -->
                    <Border Background="{DynamicResource CardHover}" CornerRadius="4" Padding="8,6" Margin="0,2,0,0">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Tổng hợp kết quả:" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock x:Name="txtXlmbCount" Text="0 phòng" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Diện tích" FontSize="8" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock x:Name="txtXlmbTotalArea" Text="0.00 m²" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentAmber}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Chu vi" FontSize="8" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock x:Name="txtXlmbTotalPerim" Text="0.00 m" FontSize="9" FontWeight="Bold" Foreground="#81C784"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Nhà WC" FontSize="8" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock x:Name="txtXlmbWcCount" Text="0 WC" FontSize="9" FontWeight="Bold" Foreground="#FF5722"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Tường Cong" FontSize="8" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock x:Name="txtXlmbCurvedCount" Text="0 Bulge" FontSize="9" FontWeight="Bold" Foreground="#9C27B0"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="txtXlmbSummary" Text="Sẵn sàng nhận lệnh từ Chỉ Huy Trưởng AI." 
                                       FontSize="9" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- BỘ LỌC TẦNG & TÌM KIẾM PHÒNG -->
            <Border Style="{DynamicResource FluidSubCardStyle}" Margin="0,6,0,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="📋 DANH MỤC PHÒNG ĐÃ NHẬN DIỆN" FontWeight="Bold" FontSize="10.5" Foreground="{DynamicResource AccentCyan}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="cbXlmbFloorFilter" Style="{DynamicResource DarkComboBoxStyle}" FontSize="9.5" SelectionChanged="CbXlmbFloorFilter_SelectionChanged">
                                        <ComboBoxItem Content="-- Tất cả khu vực / căn hộ --" IsSelected="True"/>
                                    </ComboBox>
                    </DockPanel>

                    <!-- DANH SÁCH PHÒNG CHI TIẾT (RICH CARD LISTBOX) -->
                    <ListBox x:Name="lstXlmbRooms" Background="Transparent" BorderThickness="0" 
                             MaxHeight="260" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionChanged="LstXlmbRooms_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" 
                                        BorderThickness="1" CornerRadius="4" Padding="6,5" HorizontalAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Icon phòng -->
                                        <TextBlock Grid.Column="0" Text="{Binding RoomIcon}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>

                                        <!-- Tên phòng, Mã phòng và Tầng -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <DockPanel>
                                                <TextBlock Text="{Binding Code}" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding RoomName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,1,0,0">
                                                <TextBlock Text="{Binding Floor}" FontSize="8.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding PerimeterDisplay, StringFormat='P: {0}'}" FontSize="8.5" Foreground="#81C784"/>
                                            </DockPanel>
                                        </StackPanel>

                                        <!-- Diện tích & Badges -->
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AreaDisplay}" FontWeight="Bold" FontSize="10.5" 
                                                       Foreground="{DynamicResource AccentAmber}" HorizontalAlignment="Right"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,1,0,0">
                                                <!-- Badge Sàn Âm nếu là WC -->
                                                <Border Background="#FF5722" CornerRadius="2" Padding="3,0" Margin="2,0,0,0"
                                                        Visibility="{Binding WcVisibility}">
                                                    <TextBlock Text="-50mm" FontSize="7.5" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                                <!-- Badge Tường Cong Bulge -->
                                                <Border Background="#9C27B0" CornerRadius="2" Padding="3,0" Margin="2,0,0,0"
                                                        Visibility="{Binding CurvedVisibility}">
                                                    <TextBlock Text="Bulge" FontSize="7.5" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="💡 Mẹo: Nhấp chọn 1 phòng trong danh sách để Zoom phóng to trực tiếp đến phòng đó trên CAD." 
                               FontSize="8.5" FontStyle="Italic" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Button Content="↩ Quay lại Phân Hệ Điện" Style="{DynamicResource PrimaryCyanButtonStyle}" Click="BtnBackToElectrical_Click" Margin="0,6,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
