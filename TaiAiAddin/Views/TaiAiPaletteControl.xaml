<UserControl x:Class="TaiAiAddin.Views.TaiAiPaletteControl"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 

             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 

             mc:Ignorable="d" 

             d:DesignHeight="1200" d:DesignWidth="400"

             FontFamily="Segoe UI Variable Display, Inter, Roboto, Segoe UI, sans-serif" FontSize="12"

             Background="{DynamicResource BgPrimary}" Foreground="{DynamicResource TextPrimary}"

             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">



    <UserControl.Resources>

        <!-- 1. BẢNG MÀU DYNAMIC RESOURCE MẶC ĐỊNH (TRUE OLED BLACK) -->
        <SolidColorBrush x:Key="BgPrimary" Color="#000000"/>
        <SolidColorBrush x:Key="BgSurface" Color="#000000"/>
        <SolidColorBrush x:Key="BgSubCard" Color="#000000"/>
        <SolidColorBrush x:Key="BgHover" Color="#141414"/>
        <SolidColorBrush x:Key="BorderDivider" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#00E5FF"/>

        <!-- Dải Màu Neon Đa Sắc Cyberpunk (Cyan -> Blue -> Magenta/Purple) -->
        <LinearGradientBrush x:Key="CyberpunkNeonBorderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00E5FF" Offset="0.0"/>
            <GradientStop Color="#3B82F6" Offset="0.5"/>
            <GradientStop Color="#D946EF" Offset="1.0"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="AccentAmber" Color="#FF9100"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A0A0A0"/>
        <SolidColorBrush x:Key="StatusSuccess" Color="#00E676"/>
        <SolidColorBrush x:Key="StatusWarning" Color="#FFD600"/>
        <SolidColorBrush x:Key="StatusDanger" Color="#FF5252"/>

        <!-- 2. STYLE CARD TỰ ĐỘNG THAY ĐỔI MÀU THEO THEME & HÀO QUANG KHI HOVER -->
        <Style x:Key="FluidCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgSurface}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDivider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Effect" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource CyberpunkNeonBorderBrush}" />
                    <Setter Property="BorderThickness" Value="1.2" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#00E5FF" BlurRadius="22" ShadowDepth="0" Opacity="0.85"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style SubCard bên trong & Hào quang khi Hover -->
        <Style x:Key="FluidSubCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgSubCard}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDivider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Effect" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource CyberpunkNeonBorderBrush}" />
                    <Setter Property="BorderThickness" Value="1.2" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#00E5FF" BlurRadius="18" ShadowDepth="0" Opacity="0.85"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Header Border với Hào Quang khi Hover -->
        <Style x:Key="GlowHeaderBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource BgSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDivider}" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Effect" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource CyberpunkNeonBorderBrush}" />
                    <Setter Property="BorderThickness" Value="1.5" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#00E5FF" BlurRadius="25" ShadowDepth="0" Opacity="0.9"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Expander Accordion Thu Gọn Thông Minh (Phong Cách HTOOLS) -->
        <Style x:Key="FluidAccordionExpanderStyle" TargetType="Expander">
            <Setter Property="Background" Value="{DynamicResource BgSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDivider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Effect" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border x:Name="ExpanderRootBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" ClipToBounds="False">
                            <StackPanel HorizontalAlignment="Stretch">
                                <ToggleButton x:Name="HeaderToggle" IsChecked="{Binding Path=IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Cursor="Hand" HorizontalAlignment="Stretch" Padding="8,8"
                                              Background="Transparent" BorderThickness="0">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="ToggleBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <Grid HorizontalAlignment="Stretch">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Path x:Name="ArrowIcon" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center"
                                                          Fill="{DynamicResource AccentCyan}" Data="M 0,0 L 5,4.5 L 0,9 Z" Stretch="Uniform" Width="8" Height="9"/>
                                                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                                                      ContentSource="Content" RecognizesAccessKey="True" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="ArrowIcon" Property="Data" Value="M 0,0 L 9,0 L 4.5,5 Z" />
                                                    <Setter TargetName="ArrowIcon" Property="Width" Value="9" />
                                                    <Setter TargetName="ArrowIcon" Property="Height" Value="6" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource BgHover}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <ContentPresenter ContentSource="Header" />
                                </ToggleButton>

                                <Border x:Name="ContentSite" Visibility="Collapsed" Padding="10,6,10,10"
                                        BorderBrush="{DynamicResource BorderDivider}" BorderThickness="0,1,0,0">
                                    <ContentPresenter />
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ExpanderRootBorder" Property="BorderBrush" Value="{StaticResource CyberpunkNeonBorderBrush}" />
                                <Setter TargetName="ExpanderRootBorder" Property="BorderThickness" Value="1.2" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ExpanderRootBorder" Property="BorderBrush" Value="{StaticResource CyberpunkNeonBorderBrush}" />
                                <Setter TargetName="ExpanderRootBorder" Property="BorderThickness" Value="1.2" />
                                <Setter TargetName="ExpanderRootBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00E5FF" BlurRadius="20" ShadowDepth="0" Opacity="0.85"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <!-- Style Nút Cấu Hình Co Dãn Tự Động & Đổi Màu Theo Theme -->

        <Style x:Key="FluidConfigButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="{DynamicResource BgHover}" />

            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />

            <Setter Property="FontWeight" Value="Medium" />

            <Setter Property="FontSize" Value="11.5" />

            <Setter Property="Padding" Value="10,7" />

            <Setter Property="BorderBrush" Value="{DynamicResource BorderDivider}" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="HorizontalAlignment" Value="Stretch" />

            <Setter Property="HorizontalContentAlignment" Value="Stretch" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border" Background="{TemplateBinding Background}" 

                                BorderBrush="{TemplateBinding BorderBrush}"

                                BorderThickness="{TemplateBinding BorderThickness}"

                                CornerRadius="6" Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 

                                              VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource CyberpunkNeonBorderBrush}" />
                                <Setter TargetName="border" Property="BorderThickness" Value="1.2" />
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00E5FF" BlurRadius="18" ShadowDepth="0" Opacity="0.85"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BgSubCard}" />
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!-- Style Nút Hạng Mục MEP -->

        <Style x:Key="FluidMepButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="{DynamicResource BgSurface}" />

            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />

            <Setter Property="FontWeight" Value="SemiBold" />

            <Setter Property="FontSize" Value="11.5" />

            <Setter Property="Padding" Value="4,8" />

            <Setter Property="BorderBrush" Value="{DynamicResource BorderDivider}" />

            <Setter Property="BorderThickness" Value="1.2" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="HorizontalAlignment" Value="Stretch" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border" Background="{TemplateBinding Background}" 

                                BorderBrush="{TemplateBinding BorderBrush}"

                                BorderThickness="{TemplateBinding BorderThickness}"

                                CornerRadius="6" Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BgHover}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource CyberpunkNeonBorderBrush}" />
                                <Setter TargetName="border" Property="BorderThickness" Value="1.2" />
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00E5FF" BlurRadius="20" ShadowDepth="0" Opacity="0.85"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BgSubCard}" />
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!-- Style Nút Hành Động Màu Nhấn Chính (Dynamic Accent) -->

        <Style x:Key="PrimaryCyanButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="{DynamicResource AccentCyan}" />

            <Setter Property="Foreground" Value="{DynamicResource BgPrimary}" />

            <Setter Property="FontWeight" Value="Bold" />

            <Setter Property="FontSize" Value="12" />

            <Setter Property="Padding" Value="12,8" />

            <Setter Property="BorderThickness" Value="0" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="HorizontalAlignment" Value="Stretch" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border" Background="{TemplateBinding Background}" 

                                CornerRadius="6" Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource CyberpunkNeonBorderBrush}" />

                                <Setter TargetName="border" Property="BorderThickness" Value="1.2" />

                                <Setter TargetName="border" Property="Effect">

                                    <Setter.Value>

                                        <DropShadowEffect Color="#00E5FF" BlurRadius="20" ShadowDepth="0" Opacity="0.9"/>

                                    </Setter.Value>

                                </Setter>

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="border" Property="Opacity" Value="0.75" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!-- Style TextBox Dark Mode Chuẩn -->

        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">

            <Setter Property="Background" Value="{DynamicResource BgSubCard}" />

            <Setter Property="Foreground" Value="{DynamicResource AccentCyan}" />

            <Setter Property="CaretBrush" Value="{DynamicResource AccentCyan}" />

            <Setter Property="BorderBrush" Value="{DynamicResource BorderDivider}" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="Padding" Value="6,4" />

            <Setter Property="FontSize" Value="11.5" />

            <Setter Property="FontFamily" Value="JetBrains Mono, Cascadia Code, Consolas" />

            <Setter Property="HorizontalAlignment" Value="Stretch" />

            <Setter Property="VerticalContentAlignment" Value="Center" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border x:Name="border" Background="{TemplateBinding Background}" 

                                BorderBrush="{TemplateBinding BorderBrush}" 

                                BorderThickness="{TemplateBinding BorderThickness}" 

                                CornerRadius="4">

                            <ScrollViewer x:Name="PART_ContentHost" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentCyan}" />

                            </Trigger>

                            <Trigger Property="IsFocused" Value="True">

                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentCyan}" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!-- ========================================================================= -->

        <!-- CONTROL TEMPLATE COMBOBOX DARK MODE HOÀN TOÀN: CHỐNG LỖI CHỮ TRẮNG NỀN TRẮNG -->

        <!-- ========================================================================= -->

        <Style TargetType="ComboBoxItem">

            <Setter Property="Background" Value="{DynamicResource BgSubCard}" />

            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />

            <Setter Property="FontSize" Value="11.5" />

            <Setter Property="Padding" Value="8,5" />

            <Setter Property="HorizontalContentAlignment" Value="Left" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBoxItem">

                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" 

                                Padding="{TemplateBinding Padding}" Margin="0,1" CornerRadius="3">

                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsHighlighted" Value="True">

                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BgHover}" />

                                <Setter Property="Foreground" Value="{DynamicResource AccentCyan}" />

                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">

                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentCyan}" />

                                <Setter Property="Foreground" Value="{DynamicResource BgPrimary}" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!-- ToggleButton cho ComboBox Dark Mode -->

        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">

            <Grid HorizontalAlignment="Stretch">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*" />

                    <ColumnDefinition Width="26" />

                </Grid.ColumnDefinitions>

                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="5"

                        Background="{DynamicResource BgSubCard}" BorderBrush="{DynamicResource BorderDivider}" BorderThickness="1" />

                <Path x:Name="Arrow" Grid.Column="1" Fill="{DynamicResource AccentCyan}" HorizontalAlignment="Center" VerticalAlignment="Center"

                      Data="M 0 0 L 4 4 L 8 0 Z" />

            </Grid>

            <ControlTemplate.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentCyan}" />

                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource BgHover}" />

                </Trigger>

                <Trigger Property="IsChecked" Value="True">

                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentCyan}" />

                </Trigger>

            </ControlTemplate.Triggers>

        </ControlTemplate>



        <!-- Style ComboBox Dark Mode Hoàn Chỉnh (Hỗ trợ cả Editable) -->

        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">

            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />

            <Setter Property="FontSize" Value="11.5" />

            <Setter Property="Height" Value="28" />

            <Setter Property="HorizontalAlignment" Value="Stretch" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBox">

                        <Grid HorizontalAlignment="Stretch">

                            <ToggleButton Name="ToggleButton" Template="{StaticResource DarkComboBoxToggleButton}" 

                                          Focusable="False" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 

                                          ClickMode="Press" HorizontalAlignment="Stretch" />

                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" 

                                              Content="{TemplateBinding SelectionBoxItem}" 

                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 

                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 

                                              Margin="8,2,26,2" VerticalAlignment="Center" HorizontalAlignment="Left" />

                            <TextBox x:Name="PART_EditableTextBox"

                                     Style="{StaticResource DarkTextBoxStyle}"

                                     Margin="6,2,26,2" VerticalAlignment="Center" HorizontalAlignment="Stretch"

                                     Focusable="True" Background="Transparent" BorderThickness="0"

                                     Visibility="Collapsed" IsReadOnly="{TemplateBinding IsReadOnly}"/>

                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" 

                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">

                                <Grid Name="DropDown" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="220" Margin="0,2,0,0">

                                    <Border Name="DropDownBorder" Background="{DynamicResource BgSubCard}" BorderBrush="{DynamicResource AccentCyan}" BorderThickness="1.2" CornerRadius="5">

                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">

                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />

                                        </ScrollViewer>

                                    </Border>

                                </Grid>

                            </Popup>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsEditable" Value="True">

                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>

                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!-- Style Expander Cấu Hình -->

        <Style x:Key="FluidExpanderStyle" TargetType="Expander">

            <Setter Property="Foreground" Value="{DynamicResource AccentCyan}" />

            <Setter Property="FontWeight" Value="SemiBold" />

            <Setter Property="FontSize" Value="11.5" />

            <Setter Property="Background" Value="Transparent" />

            <Setter Property="BorderThickness" Value="0" />

            <Setter Property="HorizontalAlignment" Value="Stretch" />

        </Style>

    </UserControl.Resources>



    <Grid Margin="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>  <!-- 1. Header Logo NTT TOOLS -->

            <RowDefinition Height="*"/>     <!-- Scrollable Main Content -->

            <RowDefinition Height="Auto"/>  <!-- Status bar đáy -->

        </Grid.RowDefinitions>



        <!-- 0. HÌNH NỀN DẢI NGÂN HÀ ANDROMEDA NGHỆ THUẬT (Kích hoạt khi chọn Theme 8) -->

        <Image x:Name="imgGalaxyBg" Grid.RowSpan="3" Stretch="UniformToFill" Opacity="0.30" 

               HorizontalAlignment="Center" VerticalAlignment="Center" 

               IsHitTestVisible="False" Visibility="Collapsed"/>



        <!-- ========================================================= -->

        <!-- 1. ĐẦU TIÊN: PHẦN LOGO NTT TOOLS (Co Dãn Tự Động)         -->

        <!-- ========================================================= -->

        <Border Grid.Row="0" Style="{StaticResource GlowHeaderBorderStyle}">

            <Grid HorizontalAlignment="Stretch">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>



                <!-- Galaxy Header Overlay Background -->

                <Image x:Name="imgGalaxyHeader" Grid.ColumnSpan="3" Stretch="UniformToFill" Opacity="0.45" 

                       HorizontalAlignment="Center" VerticalAlignment="Center" 

                       IsHitTestVisible="False" Visibility="Collapsed" Margin="-12,-10"/>



                <!-- Logo Badge NTT với gradient phát sáng -->

                <Border x:Name="borderLogoBadge" Grid.Column="0" Width="42" Height="42" CornerRadius="7" Margin="0,0,10,0" VerticalAlignment="Center">

                    <Border.Background>

                        <LinearGradientBrush x:Name="gradLogo" StartPoint="0,0" EndPoint="1,1">

                            <GradientStop x:Name="gradStop1" Color="#00E5FF" Offset="0"/>

                            <GradientStop x:Name="gradStop2" Color="#007ACC" Offset="1"/>

                        </LinearGradientBrush>

                    </Border.Background>

                    <TextBlock x:Name="txtLogoText" Text="NTT" Foreground="#12161F" FontWeight="Black" FontSize="14" 

                               HorizontalAlignment="Center" VerticalAlignment="Center" 

                               FontFamily="Segoe UI Black, Impact, Arial Black, Segoe UI"/>

                </Border>



                <!-- Tiêu đề & Slogan chuyên nghiệp -->

                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch">

                    <WrapPanel VerticalAlignment="Center">
                        <Path Width="14" Height="14" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"
                              Data="M12,2 C12,7.52 7.52,12 2,12 C7.52,12 12,16.48 12,22 C12,16.48 16.48,12 22,12 C16.48,12 12,7.52 12,2 Z">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#00E5FF" Offset="0.0"/>
                                    <GradientStop Color="#3B82F6" Offset="0.35"/>
                                    <GradientStop Color="#A855F7" Offset="0.7"/>
                                    <GradientStop Color="#F59E0B" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                        <TextBlock Text="NTT TOOLS" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>

                        <Border x:Name="borderBadgePro" Background="{DynamicResource AccentCyan}" CornerRadius="4" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">

                            <TextBlock x:Name="txtBadgePro" Text="PRO MEP" FontSize="8.5" FontWeight="Black" Foreground="{DynamicResource BgPrimary}"/>

                        </Border>

                    </WrapPanel>

                    <TextBlock x:Name="txtSubtitle" Text="TRỢ LÝ KỸ THUẬT CƠ ĐIỆN MEP AI" FontSize="10" Foreground="{DynamicResource AccentCyan}" Margin="0,2,0,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>

                    <TextBlock Text="Kỹ sư: Nguyễn Tấn Tài" FontSize="9.5" Foreground="{DynamicResource TextSecondary}" Margin="0,1,0,0"/>

                </StackPanel>



                <!-- Nút Reload & Về Hệ Điện -->

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">

                    <Button x:Name="btnReloadPalette" Content="🔄" ToolTip="Làm mới (Reload) toàn bộ giao diện Palette" 

                            Width="28" Height="28" Style="{StaticResource FluidConfigButtonStyle}" 

