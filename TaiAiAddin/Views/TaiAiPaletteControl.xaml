                                        Click="BtnDrawTrunking_Click" 

                                        Padding="2,7"

                                        ToolTip="Vẽ Máng Cáp (Cable Trunking) kín trơn kéo dãn Live Jig thời gian thực (Lệnh NTTTMC)">

                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                                        <TextBlock Text="⚡" FontSize="13" HorizontalAlignment="Center"/>

                                        <TextBlock Text="Trunking" FontWeight="Bold" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>

                                    </StackPanel>

                                </Button>



                                <!-- Nút 3: Thang Điện -->

                                <Button Grid.Column="4" x:Name="btnDrawLadder" 

                                        Style="{StaticResource PrimaryCyanButtonStyle}" 

                                        Click="BtnDrawLadder_Click" 

                                        Padding="2,7"

                                        ToolTip="Vẽ Thang Điện (Cable Ladder) bậc thang 250mm kéo dãn Live Jig thời gian thực (Lệnh NTTTMC)">

                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                                        <TextBlock Text="🚀" FontSize="13" HorizontalAlignment="Center"/>

                                        <TextBlock Text="Thang Điện" FontWeight="Bold" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>

                                    </StackPanel>

                                </Button>

                            </Grid>



                            <!-- Nút vẽ tự động theo Polyline -->

                            <Button x:Name="btnRouteTmcAlongPl" 

                                    Style="{StaticResource FluidConfigButtonStyle}" 

                                    Background="#E65100" Foreground="White" BorderThickness="0"

                                    Click="BtnRouteTmcAlongPl_Click" Margin="0,0,0,6"

                                    Padding="8,6"

                                    ToolTip="Chọn đường Polyline tim máng: Tự động chạy Block động, bo co 90/45 và rải giá treo 1.5m (Lệnh NTTTMCROUTE)">

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                    <TextBlock Text="📐" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>

                                    <TextBlock Text="Vẽ Tuyến TMC Theo Polyline (Tự Bo Co &amp; Giá Đỡ)" FontWeight="SemiBold" FontSize="11"/>

                                </StackPanel>

                            </Button>



                            <!-- Nút xuất bảng bóc tách khối lượng -->

                            <Button x:Name="btnDrawTmcBOMTable" Content="📋 Xuất Bảng Bóc Tách Khối Lượng Vào CAD" 

                                    Style="{StaticResource FluidConfigButtonStyle}" 

                                    Click="BtnDrawTmcBOMTable_Click" Margin="0,0,0,4"

                                    ToolTip="Bóc tách tổng chiều dài, số lượng phụ kiện co/cút, số giá treo và xuất Table CAD (Lệnh NTTTMCBOM)"/>



                            <!-- Nút mở thư viện block Điện / Thang máng -->

                            <Button x:Name="btnOpenTmcFolder" Content="📂 Mở Thư Viện Block Thang Máng Cáp" 

                                    Style="{StaticResource FluidConfigButtonStyle}" 

                                    Click="BtnOpenTmcFolder_Click" Margin="0,0,0,2"

                                    ToolTip="Mở thư mục chứa các Block DWG Thang máng, co lượn, tê cút, giá treo"/>

                        </StackPanel>

                    </Expander>



                    <!-- Nhóm 1: Các công cụ Thiết kế & Vẽ Tủ Điện -->

                    <Expander Style="{StaticResource FluidAccordionExpanderStyle}" IsExpanded="False">

                        <Expander.Header>

                            <DockPanel HorizontalAlignment="Stretch">

                                <TextBlock Text="⚡ THIẾT KẾ &amp; VẼ TỦ ĐIỆN TỰ ĐỘNG" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource AccentCyan}"/>

                                <Border Background="#00E676" CornerRadius="3" Padding="4,1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0">

                                    <TextBlock Text="SẴN SÀNG" FontSize="8.5" FontWeight="Bold" Foreground="#12161F"/>

                                </Border>

                            </DockPanel>

                        </Expander.Header>

                        <StackPanel HorizontalAlignment="Stretch">



                            <!-- Nút 1: Sơ đồ nguyên lý tủ điện (Co dãn tự động) -->

                            <Button x:Name="btnOpenElectricalDialog" Style="{StaticResource FluidConfigButtonStyle}" 

                                    Background="#E65100" Margin="0,0,0,8" Click="BtnOpenElectricalDialog_Click"

                                    BorderThickness="0" Padding="10,9"

                                    ToolTip="Tạo Sơ Đồ Nguyên Lý, chọn Aptomat, Cáp điện, Tính toán phụ tải">

                                <Grid HorizontalAlignment="Stretch">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="Auto"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="⚡" FontSize="18" Margin="2,0,10,0" VerticalAlignment="Center" Foreground="#FFD600"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch">

                                        <TextBlock Text="Vẽ Sơ Đồ Nguyên Lý Tủ Điện (SLD)" FontWeight="Bold" FontSize="12.5" Foreground="White" TextWrapping="Wrap"/>

                                        <TextBlock Text="Tính toán phụ tải, cáp nguồn, chọn Aptomat 1P/2P/3P/4P" FontSize="9.5" Foreground="#FFE0B2" TextWrapping="Wrap"/>

                                    </StackPanel>

                                </Grid>

                            </Button>



                            <!-- Nút 2: Mặt bằng bố trí vỏ tủ (Co dãn tự động) -->

                            <Button x:Name="btnOpenEnclosureDialog" Style="{StaticResource FluidConfigButtonStyle}" 

                                    Background="#6A1B9A" Click="BtnOpenEnclosureDialog_Click"

                                    BorderThickness="0" Padding="10,9"

                                    ToolTip="Thiết kế, Tùy chỉnh Block và Bố trí Mặt bằng Vỏ tủ điện Form 2B">

                                <Grid HorizontalAlignment="Stretch">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="Auto"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="📐" FontSize="18" Margin="2,0,10,0" VerticalAlignment="Center" Foreground="#E1BEE7"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch">

                                        <TextBlock Text="Vẽ Mặt Bằng Bố Trí Vỏ Tủ Điện" FontWeight="Bold" FontSize="12.5" Foreground="White" TextWrapping="Wrap"/>

                                        <TextBlock Text="Preview Canvas, sắp xếp MCB, MCCB, Đèn báo, Đồng hồ" FontSize="9.5" Foreground="#E1BEE7" TextWrapping="Wrap"/>

                                    </StackPanel>

                                </Grid>

                            </Button>

                        </StackPanel>

                    </Expander>



                    <!-- Nhóm 2: Đo đạc & Thống kê khối lượng Line / Pline / Dây cáp -->

                    <Expander Style="{StaticResource FluidAccordionExpanderStyle}" IsExpanded="False">

                        <Expander.Header>

                            <DockPanel HorizontalAlignment="Stretch">

                                <TextBlock Text="📊 BÓC TÁCH KHỐI LƯỢNG DÂY &amp; ỐNG" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource AccentCyan}"/>

                                <TextBlock Text="Line / Polyline" FontSize="9.5" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                            </DockPanel>

                        </Expander.Header>

                        <StackPanel HorizontalAlignment="Stretch">



                            <!-- Cấu hình đơn vị & tạo bảng -->

                            <Grid Margin="0,0,0,8" HorizontalAlignment="Stretch">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Đơn vị:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                                    <RadioButton x:Name="rbMeters" Content="Mét (m)" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="0,0,12,0"/>

                                    <RadioButton x:Name="rbMillimeters" Content="Milimét (mm)" Foreground="{DynamicResource TextPrimary}"/>

                                </StackPanel>

                            </Grid>



                            <CheckBox x:Name="chkAutoCreateTable" Content="Yêu cầu chọn điểm chèn Bảng ngay sau khi quét" 

                                      IsChecked="True" Foreground="{DynamicResource TextPrimary}" FontSize="11" Margin="0,0,0,10"/>



                            <!-- Nút quét chọn và tính toán (Co dãn tự động) -->

                            <Button x:Name="btnSelectAndCalculate" Content="🚀 Quét Chọn Đối Tượng (Line / Pline)" 

                                    Style="{StaticResource PrimaryCyanButtonStyle}" 

                                    Click="BtnSelectAndCalculate_Click" Margin="0,0,0,6"/>



                            <!-- Nút chèn lại bảng (Co dãn tự động) -->

                            <Button x:Name="btnCreateTableOnly" Content="📋 Chèn Lại Bảng Vào Bản Vẽ" 

                                    Style="{StaticResource FluidConfigButtonStyle}" 

                                    Click="BtnCreateTableOnly_Click" IsEnabled="False" Margin="0,0,0,10"/>



                            <!-- DataGrid Kết Quả Thống Kê Theo Layer (Co Dãn Tự Động) -->

                            <Border Background="{DynamicResource BgSubCard}" CornerRadius="6" BorderBrush="{DynamicResource BorderDivider}" BorderThickness="1" 

                                    Padding="2" Margin="0,0,0,8" HorizontalAlignment="Stretch">

                                <DataGrid x:Name="dgResults" AutoGenerateColumns="False" 

                                          CanUserAddRows="False" CanUserDeleteRows="False"

                                          IsReadOnly="True" GridLinesVisibility="Horizontal"

                                          HorizontalGridLinesBrush="{DynamicResource BgHover}"

                                          HeadersVisibility="Column"

                                          Background="{DynamicResource BgSubCard}" RowBackground="{DynamicResource BgSubCard}" AlternatingRowBackground="{DynamicResource BgSurface}"

                                          Foreground="{DynamicResource TextPrimary}" BorderThickness="0"

                                          RowHeight="25" FontSize="10.5" MaxHeight="180" HorizontalAlignment="Stretch">

                                    <DataGrid.ColumnHeaderStyle>

                                        <Style TargetType="DataGridColumnHeader">

                                            <Setter Property="Background" Value="{DynamicResource BgSurface}"/>

                                            <Setter Property="Foreground" Value="{DynamicResource AccentCyan}"/>

                                            <Setter Property="FontWeight" Value="SemiBold"/>

                                            <Setter Property="Padding" Value="6,4"/>

                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderDivider}"/>

                                            <Setter Property="BorderThickness" Value="0,0,1,1"/>

                                        </Style>

                                    </DataGrid.ColumnHeaderStyle>

                                    <DataGrid.Columns>

                                        <DataGridTextColumn Header="STT" Binding="{Binding Stt}" Width="35"/>

                                        <DataGridTextColumn Header="Layer" Binding="{Binding LayerName}" Width="*"/>

                                        <DataGridTextColumn Header="Line" Binding="{Binding LineCount}" Width="40"/>

                                        <DataGridTextColumn Header="Pline" Binding="{Binding PolylineCount}" Width="45"/>

                                        <DataGridTextColumn Header="Tổng Dài" Binding="{Binding FormattedLengthM}" Width="75"/>

                                    </DataGrid.Columns>

                                </DataGrid>

                            </Border>



                            <!-- Thẻ tóm tắt kết quả (Summary Card - Co Dãn Tự Động) -->

                            <Border Background="{DynamicResource BgSubCard}" CornerRadius="6" BorderBrush="{DynamicResource BorderDivider}" BorderThickness="1" 

                                    Padding="10,8" HorizontalAlignment="Stretch">

                                <Grid HorizontalAlignment="Stretch">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">

                                        <TextBlock Text="Tổng đối tượng:" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>

                                        <TextBlock x:Name="txtTotalCount" Text="0 đối tượng" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource AccentCyan}"/>

                                    </StackPanel>

                                    <StackPanel Grid.Column="1">

                                        <TextBlock Text="Tổng chiều dài:" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>

                                        <TextBlock x:Name="txtTotalLength" Text="0.00 m" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource StatusSuccess}"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </StackPanel>

                    </Expander>

                </StackPanel>



            </StackPanel>

        </ScrollViewer>



        <!-- ========================================================= -->

        <!-- STATUS BAR ĐÁY (CO DÃN TỰ ĐỘNG)                           -->

        <!-- ========================================================= -->

        <Border Grid.Row="2" Background="{DynamicResource BgSurface}" CornerRadius="6" BorderBrush="{DynamicResource BorderDivider}" BorderThickness="1" 

                Padding="8,5" Margin="0,8,0,0" HorizontalAlignment="Stretch">

            <DockPanel HorizontalAlignment="Stretch">

                <TextBlock Text="STATUS:" FontWeight="Bold" FontSize="9.5" Foreground="{DynamicResource AccentCyan}" Margin="0,0,6,0" VerticalAlignment="Center"/>

                <TextBlock x:Name="txtStatus" Text="Sẵn sàng. Lệnh 'NTT' hoặc 'TaiAi' để mở Palette." 

                           FontSize="10" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

            </DockPanel>

        </Border>

    </Grid>

</UserControl>

