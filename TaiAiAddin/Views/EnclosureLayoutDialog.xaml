<Window x:Class="TaiAiAddin.Views.EnclosureLayoutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="NTT TOOLS - Thiết Kế &amp; Bố Trí Mặt Bằng Vỏ Tủ Điện Công Nghiệp (Form 2B)"
        Width="1320" Height="840" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="12" Background="#F4F6F9"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Button Styles -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#007ACC" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PurpleBtn" TargetType="Button">
            <Setter Property="Background" Value="#6A1B9A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4A148C" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#E9ECEF" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#CED4DA" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DEE2E6" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Card Container Style -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="BorderBrush" Value="#E1E4E8" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#1A237E" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="InputLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#555" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <Style x:Key="SubtleCheck" TargetType="CheckBox">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#333" />
            <Setter Property="Margin" Value="0,3,0,3" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: Header Banner -->
            <RowDefinition Height="*"/>     <!-- 1: Main Workspace Split -->
            <RowDefinition Height="Auto"/>  <!-- 2: Bottom Action Bar -->
        </Grid.RowDefinitions>

        <!-- 0. Header Banner -->
        <Border Grid.Row="0" Background="#1A1D20" BorderBrush="#2D3339" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- NTT Logo Badge -->
                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="6" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#6A1B9A" Offset="0"/>
                            <GradientStop Color="#4A148C" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="NTT" Foreground="White" FontWeight="Black" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI Black, Impact, Segoe UI"/>
                </Border>

                <!-- Titles -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="NTT TOOLS - THIẾT KẾ &amp; BỐ TRÍ MẶT BẰNG VỎ TỦ ĐIỆN CÔNG NGHIỆP" 
                                   FontWeight="Bold" FontSize="14" Foreground="#FFFFFF"/>
                        <Border Background="#6A1B9A" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="FORM 2B / TD.DWG" FontSize="9" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Kéo thả di chuyển trực tiếp trên bản vẽ • Tùy chỉnh vị trí &amp; Text • Thêm/Bỏ Block • Xuất bản vẽ CAD chuẩn xác" 
                               FontSize="11" Foreground="#CE93D8" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Header Quick Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnAutoFitPanel" Content="⚡ Tự Động Tính Theo Tải" 
                            Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"
                            Click="BtnAutoFitPanel_Click"
                            ToolTip="Tự động tính toán kích thước W x H x D tối ưu dựa theo số lượng thiết bị"/>
                    <Button x:Name="btnResetDefaults" Content="🔄 Đặt Lại Chuẩn TD.dwg" 
                            Style="{StaticResource SecondaryBtn}"
                            Click="BtnResetDefaults_Click"
                            ToolTip="Khôi phục kích thước 700x1625x400 và cấu hình mặc định"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. Main Content Split View -->
        <Grid Grid.Row="1" Margin="10,10,10,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" MinWidth="370" MaxWidth="540"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: TabControl (Cấu Hình & Danh Sách Đối Tượng) -->
            <TabControl Grid.Column="0" Background="#F8F9FA" BorderBrush="#CED4DA">
                <!-- Tab 1: Cấu hình chung -->
                <TabItem Header="⚙️ Cấu Hình Chung" FontWeight="SemiBold">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6,8,8,0">
                        <StackPanel>
                            <!-- Card 1: Chọn Tủ Điện -->
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="📦 CHỌN TỦ ĐIỆN ĐỂ BỐ TRÍ" Style="{StaticResource SectionTitle}"/>
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="cboPanels" Grid.Column="0" Height="26" 
                                                  SelectionChanged="CboPanels_SelectionChanged"
                                                  DisplayMemberPath="PanelName"
                                                  ToolTip="Chọn tủ điện từ danh sách đang có"/>
                                        <Button x:Name="btnReloadPanels" Grid.Column="1" Content="↻" Width="28" Height="26" 
                                                Margin="6,0,0,0" Style="{StaticResource SecondaryBtn}"
                                                Click="BtnReloadPanels_Click" ToolTip="Làm mới danh sách tủ"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Kích Thước Vỏ Tủ (mm) -->
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="📐 KÍCH THƯỚC HÌNH HỌC VỎ TỦ (MM)" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left"/>
                                        <Border Background="#EDE7F6" CornerRadius="3" Padding="6,2" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                            <TextBlock x:Name="txtTotalHeightBadge" Text="Tổng H: 1800 mm" FontWeight="Bold" FontSize="10.5" Foreground="#6A1B9A"/>
                                        </Border>
                                    </DockPanel>

                                    <Grid Margin="0,2,0,4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Width W -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,6">
                                            <TextBlock Text="Chiều rộng (W):" Style="{StaticResource InputLabel}"/>
                                            <TextBox x:Name="txtWidth" Text="700" Height="24" TextChanged="InputControl_Changed" Padding="4,2"/>
                                        </StackPanel>

                                        <!-- Height H -->
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="6,0,0,6">
                                            <TextBlock Text="Chiều cao vỏ (H):" Style="{StaticResource InputLabel}"/>
                                            <TextBox x:Name="txtHeight" Text="1625" Height="24" TextChanged="InputControl_Changed" Padding="4,2"/>
                                        </StackPanel>

                                        <!-- Depth D -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,6,6">
                                            <TextBlock Text="Chiều sâu tủ (D):" Style="{StaticResource InputLabel}"/>
                                            <TextBox x:Name="txtDepth" Text="400" Height="24" TextChanged="InputControl_Changed" Padding="4,2"/>
                                        </StackPanel>

                                        <!-- Plinth Height -->
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,6">
                                            <TextBlock Text="Cao chân đế (Plinth):" Style="{StaticResource InputLabel}"/>
                                            <TextBox x:Name="txtPlinth" Text="100" Height="24" TextChanged="InputControl_Changed" Padding="4,2"/>
                                        </StackPanel>

                                        <!-- Canopy Height -->
                                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="Cao nóc che (Canopy):" Style="{StaticResource InputLabel}"/>
                                            <TextBox x:Name="txtCanopy" Text="75" Height="24" TextChanged="InputControl_Changed" Padding="4,2"/>
                                        </StackPanel>

                                        <!-- Text Height in CAD -->
                                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="Cỡ chữ CAD (mm):" Style="{StaticResource InputLabel}"/>
                                            <TextBox x:Name="txtCadTextHeight" Text="12" Height="24" TextChanged="InputControl_Changed" Padding="4,2"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Căn Chỉnh Text & Nhãn Kỹ Thuật -->
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="✍️ CĂN CHỈNH TEXT &amp; NHÃN THÔNG SỐ" Style="{StaticResource SectionTitle}"/>

                                    <StackPanel Margin="0,2,0,5">
                                        <TextBlock Text="Tên tủ điện (Mica Nameplate):" Style="{StaticResource InputLabel}"/>
                                        <TextBox x:Name="txtPanelName" Text="DB-HVAC-01" Height="24" TextChanged="InputControl_Changed" Padding="4,2" FontWeight="Bold"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,5">
                                        <TextBlock Text="Điện áp &amp; Tần số:" Style="{StaticResource InputLabel}"/>
                                        <TextBox x:Name="txtVoltage" Text="3P4W 380V/220V, 50Hz" Height="24" TextChanged="InputControl_Changed" Padding="4,2"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,5">
                                        <TextBlock Text="Quy cách lỗ khoét đáy cáp:" Style="{StaticResource InputLabel}"/>
                                        <TextBox x:Name="txtCableHole" Text="450 x 220 mm" Height="24" TextChanged="InputControl_Changed" Padding="4,2"/>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="Cấp bảo vệ (IP):" Style="{StaticResource InputLabel}"/>
                                            <TextBox x:Name="txtProtection" Text="IP43 / IP54" Height="24" TextChanged="InputControl_Changed" Padding="4,2"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="Màu sơn tĩnh điện:" Style="{StaticResource InputLabel}"/>
                                            <TextBox x:Name="txtColor" Text="RAL 7035" Height="24" TextChanged="InputControl_Changed" Padding="4,2"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="0,0,0,0">
                                        <TextBlock Text="Vật liệu chế tạo vỏ tủ:" Style="{StaticResource InputLabel}"/>
                                        <TextBox x:Name="txtMaterial" Text="Thép cán nguội (SPCC) dày 1.5 - 2.0 mm" Height="24" TextChanged="InputControl_Changed" Padding="4,2"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Card 4: Thêm / Bỏ Các Hình Chiếu (Views) -->
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="🖼️ THÊM / BỎ CÁC HÌNH CHIẾU (VIEWS)" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left"/>
                                        <TextBlock Text="Tích chọn để vẽ" FontSize="10" Foreground="#888" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                    </DockPanel>

                                    <CheckBox x:Name="chkFrontView" Content="1. Mặt trước cánh ngoài (Front Door View)" IsChecked="True" 
                                              Style="{StaticResource SubtleCheck}" Click="InputControl_Changed" FontWeight="SemiBold"/>
                                    <CheckBox x:Name="chkInnerDoorView" Content="2. Mặt cánh phụ bảo vệ trong (Inner Door View)" IsChecked="True" 
                                              Style="{StaticResource SubtleCheck}" Click="InputControl_Changed" FontWeight="SemiBold"/>
                                    <CheckBox x:Name="chkInternalView" Content="3. Mặt thiết bị bên trong (Internal Equipment)" IsChecked="True" 
                                              Style="{StaticResource SubtleCheck}" Click="InputControl_Changed" FontWeight="SemiBold"/>
                                    <CheckBox x:Name="chkSideView" Content="4. Mặt cắt hông tủ (Side View)" IsChecked="True" 
                                              Style="{StaticResource SubtleCheck}" Click="InputControl_Changed" FontWeight="SemiBold"/>
                                    <CheckBox x:Name="chkBottomView" Content="5. Mặt đáy &amp; khoét lỗ cáp (Bottom View)" IsChecked="True" 
                                              Style="{StaticResource SubtleCheck}" Click="InputControl_Changed" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 5: Thêm / Bỏ Blocks Cánh Tủ -->
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="🚪 THÊM / BỎ BLOCKS TRÊN CÁNH TỦ" Style="{StaticResource SectionTitle}"/>

                                    <CheckBox x:Name="chkNameplate" Content="Bảng tên Mica tủ (Block HNP1_200X40)" IsChecked="True" 
                                              Style="{StaticResource SubtleCheck}" Click="InputControl_Changed"/>
                                    <CheckBox x:Name="chkPhaseLamps" Content="Khối PM &amp; 3 Đèn báo pha (Block PM+BÁO PHA)" IsChecked="True" 
                                              Style="{StaticResource SubtleCheck}" Click="InputControl_Changed"/>
                                    <CheckBox x:Name="chkControlStations" Content="Cụm nút nhấn &amp; Chuyển mạch A-O-M (Block A-O-M)" IsChecked="True" 
                                              Style="{StaticResource SubtleCheck}" Click="InputControl_Changed"/>
                                    <CheckBox x:Name="chkEmergencyStop" Content="Nút nhấn dừng khẩn cấp (Block EM)" IsChecked="True" 
                                              Style="{StaticResource SubtleCheck}" Click="InputControl_Changed"/>
                                    <CheckBox x:Name="chkDoorLock" Content="Khóa tay nắm tủ ngoài (Block KHOÁ NGOÀI)" IsChecked="True" 
                                              Style="{StaticResource SubtleCheck}" Click="InputControl_Changed"/>
                                    <CheckBox x:Name="chkVentFan" Content="Quạt thông gió &amp; Lưới lọc bụi (EXHAUST FAN)" IsChecked="True" 
                                              Style="{StaticResource SubtleCheck}" Click="InputControl_Changed"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 6: Thêm / Bỏ Blocks Thiết Bị Bên Trong -->
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="⚙️ THÊM / BỎ BLOCKS THIẾT BỊ BÊN TRONG" Style="{StaticResource SectionTitle}"/>

                                    <CheckBox x:Name="chkBusbar" Content="Thanh cái đồng Busbar chính &amp; phân nhánh" IsChecked="True" 
                                              Style="{StaticResource SubtleCheck}" Click="InputControl_Changed"/>
                                    <CheckBox x:Name="chkMainMccb" Content="MCCB tổng Schneider EZS (100A - 250A)" IsChecked="True" 
                                              Style="{StaticResource SubtleCheck}" Click="InputControl_Changed"/>
                                    <CheckBox x:Name="chkBranchMcbs" Content="Dãy MCB/RCBO các nhánh tải (MCB 1P/2P/3P/4P, RCCB)" IsChecked="True" 
                                              Style="{StaticResource SubtleCheck}" Click="InputControl_Changed"/>
                                    <CheckBox x:Name="chkLargeFrameMcb" Content="   ↳ Dùng MCB 2P/3P khung lớn (mcb 2p L / MCB 3P L)" IsChecked="False" 
                                              Style="{StaticResource SubtleCheck}" Click="InputControl_Changed" Margin="16,0,0,6"/>
                                    <CheckBox x:Name="chkStarters" Content="Bộ khởi động Contactor + Rơ le nhiệt TOR" IsChecked="True" 
                                              Style="{StaticResource SubtleCheck}" Click="InputControl_Changed"/>
                                    <CheckBox x:Name="chkRelays" Content="Rơ le kiếng 14 chân + Mikro pha + Cầu chì" IsChecked="True" 
                                              Style="{StaticResource SubtleCheck}" Click="InputControl_Changed"/>
                                    <CheckBox x:Name="chkTerminals" Content="Hàng kẹp cực nối dây Domino 15A" IsChecked="True" 
                                              Style="{StaticResource SubtleCheck}" Click="InputControl_Changed"/>
                                    <CheckBox x:Name="chkWiringDucts" Content="Máng cáp xẻ rãnh đi dây kỹ thuật (Duct 60x60)" IsChecked="True" 
                                              Style="{StaticResource SubtleCheck}" Click="InputControl_Changed"/>
                                    <CheckBox x:Name="chkDimensions" Content="Đường gióng kích thước (Dimensions W, H, D)" IsChecked="True" 
                                              Style="{StaticResource SubtleCheck}" Click="InputControl_Changed"/>
                                    <CheckBox x:Name="chkSpecTable" Content="Bảng chỉ dẫn tiêu chuẩn kỹ thuật vỏ tủ (Specs)" IsChecked="True" 
                                              Style="{StaticResource SubtleCheck}" Click="InputControl_Changed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 2: Danh Sách Đối Tượng (Tree List) -->
                <TabItem Header="📑 Cây Đối Tượng" FontWeight="SemiBold">
                    <Grid Margin="6,8,6,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Click vào đối tượng để chọn &amp; căn chỉnh trên Canvas:" 
                                   FontSize="11" Foreground="#555" Margin="2,0,0,6"/>
                        <ListBox Grid.Row="1" x:Name="lstItemsTree" SelectionChanged="LstItemsTree_SelectionChanged"
                                 Background="White" BorderBrush="#E1E4E8">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="2,3">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="11" DockPanel.Dock="Left"/>
                                        <TextBlock Text="{Binding Category}" FontSize="9.5" Foreground="#777" Margin="6,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                        <Border Background="#E8EAF6" CornerRadius="3" Padding="4,1" Margin="4,0,0,0" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                            <TextBlock FontSize="9.5" Foreground="#3F51B5">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="X:{0:0} Y:{1:0}">
                                                        <Binding Path="OffsetX"/>
                                                        <Binding Path="OffsetY"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Border>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Grid Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="#D0D4DC" Cursor="SizeWE"/>

            <!-- RIGHT COLUMN: Interactive 2D Editor Canvas -->
            <Border Grid.Column="2" Background="White" CornerRadius="6" BorderBrush="#E1E4E8" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- 0: Header & Zoom -->
                        <RowDefinition Height="Auto"/> <!-- 1: Inspector & Manipulation Toolbar -->
                        <RowDefinition Height="*"/>    <!-- 2: Interactive Canvas Area -->
                    </Grid.RowDefinitions>

                    <!-- 0: Preview Header & Zoom Bar -->
                    <Border Grid.Row="0" Background="#F1F3F5" BorderBrush="#E1E4E8" BorderThickness="0,0,0,1" Padding="10,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="👁️ BẢN VẼ MẶT BẰNG BỐ TRÍ VỎ TỦ (INTERACTIVE 2D CANVAS)" 
                                           FontWeight="Bold" FontSize="11" Foreground="#1A237E" VerticalAlignment="Center"/>
                                <TextBlock Text="• Giữ chuột trái kéo thả trực tiếp để di chuyển đối tượng" 
                                           FontSize="10.5" Foreground="#666" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Zoom & Scale Controls -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="btnZoomOut" Content="➖" Width="26" Height="24" Style="{StaticResource SecondaryBtn}" Click="BtnZoomOut_Click" ToolTip="Thu nhỏ"/>
                                <Slider x:Name="sliderZoom" Width="100" Minimum="0.3" Maximum="2.2" Value="1.0" 
                                        VerticalAlignment="Center" Margin="6,0,6,0" ValueChanged="SliderZoom_ValueChanged"/>
                                <Button x:Name="btnZoomIn" Content="➕" Width="26" Height="24" Style="{StaticResource SecondaryBtn}" Click="BtnZoomIn_Click" ToolTip="Phóng to"/>
                                <TextBlock x:Name="txtZoomPercent" Text="100%" Width="42" TextAlignment="Center" 
                                           VerticalAlignment="Center" FontSize="10.5" Foreground="#555" Margin="4,0,4,0"/>
                                <Button x:Name="btnZoomFit" Content="📐 Vừa Khung" Height="24" Style="{StaticResource SecondaryBtn}" 
                                        Click="BtnZoomFit_Click" Margin="4,0,4,0" ToolTip="Tự căn chỉnh vừa màn hình"/>
                                <Button x:Name="btnRefreshPreview" Content="🔄 Làm Mới" Height="24" Style="{StaticResource SecondaryBtn}" 
                                        Click="BtnRefreshPreview_Click" ToolTip="Cập nhật lại hình ảnh"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 1: Interactive Inspector & Operation Toolbar -->
                    <Border Grid.Row="1" Background="#EDE7F6" BorderBrush="#D1C4E9" BorderThickness="0,0,0,1" Padding="10,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Selected Item Badge -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Border Background="#6A1B9A" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                    <TextBlock Text="ĐỐI TƯỢNG" FontWeight="Bold" FontSize="9" Foreground="White"/>
                                </Border>
                                <TextBlock x:Name="txtSelectedName" Text="Chưa chọn đối tượng nào (Click vào hình vẽ để chọn)" 
                                           FontWeight="Bold" FontSize="11" Foreground="#4A148C" VerticalAlignment="Center"
                                           MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Position offsets, nudge and text editor -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Offsets -->
                                <TextBlock Text="ΔX:" VerticalAlignment="Center" Margin="0,0,2,0" FontSize="11" Foreground="#333"/>
                                <TextBox x:Name="txtItemOffX" Width="42" Height="22" Text="0" TextAlignment="Center" 
                                         VerticalContentAlignment="Center" KeyDown="TxtItemOffset_KeyDown" ToolTip="Nhập độ lệch X (mm) rồi nhấn Enter"/>
                                <TextBlock Text="mm  ΔY:" VerticalAlignment="Center" Margin="2,0,2,0" FontSize="11" Foreground="#333"/>
                                <TextBox x:Name="txtItemOffY" Width="42" Height="22" Text="0" TextAlignment="Center" 
                                         VerticalContentAlignment="Center" KeyDown="TxtItemOffset_KeyDown" ToolTip="Nhập độ lệch Y (mm) rồi nhấn Enter"/>
                                <TextBlock Text="mm" VerticalAlignment="Center" Margin="2,0,8,0" FontSize="10.5" Foreground="#666"/>

                                <!-- Nudge Buttons -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                    <Button x:Name="btnNudgeLeft" Content="◀" Width="22" Height="22" Style="{StaticResource SecondaryBtn}" Click="BtnNudge_Click" ToolTip="Dịch sang trái (Phím Mũi tên Trái)"/>
                                    <Button x:Name="btnNudgeRight" Content="▶" Width="22" Height="22" Style="{StaticResource SecondaryBtn}" Click="BtnNudge_Click" Margin="2,0,0,0" ToolTip="Dịch sang phải (Phím Mũi tên Phải)"/>
                                    <Button x:Name="btnNudgeUp" Content="▲" Width="22" Height="22" Style="{StaticResource SecondaryBtn}" Click="BtnNudge_Click" Margin="2,0,0,0" ToolTip="Dịch lên trên (Phím Mũi tên Lên)"/>
                                    <Button x:Name="btnNudgeDown" Content="▼" Width="22" Height="22" Style="{StaticResource SecondaryBtn}" Click="BtnNudge_Click" Margin="2,0,0,0" ToolTip="Dịch xuống dưới (Phím Mũi tên Xuống)"/>
                                    <ComboBox x:Name="cboNudgeStep" Width="55" Height="22" Margin="3,0,0,0" SelectedIndex="2" ToolTip="Bước dịch chuyển mỗi lần click">
                                        <ComboBoxItem Content="1 mm"/>
                                        <ComboBoxItem Content="5 mm"/>
                                        <ComboBoxItem Content="10 mm"/>
                                        <ComboBoxItem Content="50 mm"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Custom Text Editor -->
                                <TextBlock Text="Text:" VerticalAlignment="Center" Margin="0,0,3,0" FontSize="11" Foreground="#333"/>
                                <TextBox x:Name="txtItemText" Width="120" Height="22" VerticalContentAlignment="Center"
                                         TextChanged="TxtItemText_TextChanged" ToolTip="Chỉnh sửa nội dung chữ trực tiếp của đối tượng đang chọn"/>
                            </StackPanel>

                            <!-- Action tools -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="chkSnapGrid" Content="Hít lưới 10mm" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"/>
                                <Button x:Name="btnResetItemPos" Content="🔄 Vị trí gốc" Height="22" Padding="6,1" Style="{StaticResource SecondaryBtn}" 
                                        Click="BtnResetItemPos_Click" Margin="0,0,3,0" ToolTip="Khôi phục vị trí mặc định ban đầu của đối tượng này"/>
                                <Button x:Name="btnLockItem" Content="🔓 Khóa" Height="22" Padding="6,1" Style="{StaticResource SecondaryBtn}" 
                                        Click="BtnLockItem_Click" Margin="0,0,3,0" ToolTip="Khóa / Mở khóa vị trí để chống vô tình kéo lệch"/>
                                <Button x:Name="btnDeleteItem" Content="🗑️ Xóa" Height="22" Padding="6,1" 
                                        Background="#FFEBEE" Foreground="#C62828" BorderBrush="#EF9A9A"
                                        Click="BtnDeleteItem_Click" Margin="0,0,3,0" ToolTip="Ẩn / Xóa đối tượng khỏi bản vẽ (Phím Delete)"/>
                                <Button x:Name="btnResetAllItems" Content="🔄 Reset tất cả" Height="22" Padding="6,1" Style="{StaticResource SecondaryBtn}" 
                                        Click="BtnResetAllItems_Click" ToolTip="Khôi phục toàn bộ các đối tượng về vị trí ban đầu"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 2: Canvas Workspace inside ScrollViewer -->
                    <ScrollViewer Grid.Row="2" x:Name="scrollPreview" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#23272E">
                        <Border Background="White" Margin="25" HorizontalAlignment="Center" VerticalAlignment="Center"
                                BorderBrush="#444" BorderThickness="1" CornerRadius="3">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.35" ShadowDepth="4"/>
                            </Border.Effect>
                            <Canvas x:Name="previewCanvas" Width="980" Height="580" Background="White"
                                    MouseDown="PreviewCanvas_MouseDown">
                                <Canvas.LayoutTransform>
                                    <ScaleTransform x:Name="canvasScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
                                </Canvas.LayoutTransform>
                            </Canvas>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 2. Bottom Action Bar -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E1E4E8" BorderThickness="0,1,0,0" Padding="14,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="txtStatus" 
                               Text="✅ Sẵn sàng. Bạn có thể kéo thả di chuyển đối tượng trực tiếp trên hình vẽ rồi nhấn 'VẼ VÀO AUTOCAD'." 
                               Foreground="#2E7D32" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnDrawToCad" Content="📐 VẼ VÀO AUTOCAD" 
                            Style="{StaticResource PurpleBtn}" Width="180" Height="36"
                            Click="BtnDrawToCad_Click" Margin="0,0,10,0"
                            ToolTip="Chọn điểm đặt và xuất toàn bộ bản vẽ mặt bằng vỏ tủ vào AutoCAD"/>
                    <Button x:Name="btnClose" Content="Đóng" 
                            Style="{StaticResource SecondaryBtn}" Width="80" Height="36"
                            Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
